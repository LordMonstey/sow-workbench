if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT OR NOT DEFINED EXPECTED_CASES OR NOT DEFINED EXPECTED_CHECKS)
 message(FATAL_ERROR "EXE, OUTPUT_ROOT and exact expected coverage required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(report "${OUTPUT_ROOT}/logicalmaps-${stamp}-${nonce}.json")
if(EXISTS "${report}")
 message(FATAL_ERROR "Report must be new")
endif()
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("${out}${err}")
if(NOT result EQUAL 0 OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Independent logical-map test failed")
endif()
file(READ "${report}" body)
string(JSON status GET "${body}" status)
string(JSON groups GET "${body}" groups)
string(JSON cases GET "${body}" cases)
string(JSON checks GET "${body}" checks)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 3 OR NOT cases EQUAL EXPECTED_CASES OR NOT checks EQUAL EXPECTED_CHECKS)
 message(FATAL_ERROR "Incomplete independent coverage")
endif()
