foreach(Monstey_Required IN ITEMS Monstey_Exe Monstey_Data Monstey_Core Monstey_Out Monstey_SourceRoot Monstey_BuildRoot Monstey_Config)
  if(NOT DEFINED ${Monstey_Required} OR "${${Monstey_Required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${Monstey_Required}")
  endif()
endforeach()
foreach(Monstey_Artifact IN ITEMS Monstey_Exe Monstey_Data Monstey_Core)
  cmake_path(IS_PREFIX Monstey_BuildRoot "${${Monstey_Artifact}}" NORMALIZE Monstey_WithinBuild)
  if(NOT Monstey_WithinBuild)
    message(FATAL_ERROR "${Monstey_Artifact} must come from this actual cohort build")
  endif()
endforeach()
if(EXISTS "${Monstey_Out}/actual-differential.json" OR EXISTS "${Monstey_Out}/cohort-bindings.json")
  message(FATAL_ERROR "Fresh report required; existing evidence retained without replay")
endif()
file(MAKE_DIRECTORY "${Monstey_Out}")
execute_process(COMMAND "${Monstey_Exe}" "${Monstey_Out}/actual-differential.json"
  RESULT_VARIABLE Monstey_Code OUTPUT_FILE "${Monstey_Out}/stdout.txt"
  ERROR_FILE "${Monstey_Out}/stderr.txt" TIMEOUT 120)
if(NOT Monstey_Code EQUAL 0)
  message(FATAL_ERROR "Actual independent differential failed (${Monstey_Code}); retained ${Monstey_Out}")
endif()
file(READ "${Monstey_Out}/actual-differential.json" Monstey_Report)
string(JSON Monstey_Status GET "${Monstey_Report}" status)
if(NOT Monstey_Status STREQUAL "PASS")
  message(FATAL_ERROR "Actual differential report is not PASS")
endif()
foreach(Monstey_Check IN ITEMS cases=95 mismatches=0 literal_failures=0 fault_cases=26)
  string(REPLACE "=" ";" Monstey_Parts "${Monstey_Check}")
  list(GET Monstey_Parts 0 Monstey_Key)
  list(GET Monstey_Parts 1 Monstey_Expected)
  string(JSON Monstey_Actual GET "${Monstey_Report}" "${Monstey_Key}")
  if(NOT "${Monstey_Actual}" STREQUAL "${Monstey_Expected}")
    message(FATAL_ERROR "${Monstey_Key}: ${Monstey_Actual}, expected ${Monstey_Expected}")
  endif()
endforeach()
string(JSON Monstey_Rows LENGTH "${Monstey_Report}" rows)
if(NOT Monstey_Rows EQUAL 95)
  message(FATAL_ERROR "Parent full95 corpus not preserved")
endif()
string(JSON Monstey_Value GET "${Monstey_Report}" physical_CPU_OS_concurrency_qualified)
if(Monstey_Value)
  message(FATAL_ERROR "Unexpected scope claim: physical_CPU_OS_concurrency_qualified")
endif()
string(JSON Monstey_Value GET "${Monstey_Report}" passive_product_memory_trace)
if(Monstey_Value)
  message(FATAL_ERROR "Unexpected scope claim: passive_product_memory_trace")
endif()
string(JSON Monstey_Value GET "${Monstey_Report}" full_higher239_qualified)
if(Monstey_Value)
  message(FATAL_ERROR "Unexpected scope claim: full_higher239_qualified")
endif()
string(JSON Monstey_Value GET "${Monstey_Report}" full_goal_complete)
if(Monstey_Value)
  message(FATAL_ERROR "Unexpected scope claim: full_goal_complete")
endif()
string(JSON Monstey_Value GET "${Monstey_Report}" native_original_entrypoint_invoked)
if(Monstey_Value)
  message(FATAL_ERROR "Unexpected scope claim: native_original_entrypoint_invoked")
endif()
string(JSON Monstey_Value GET "${Monstey_Report}" original_instruction_bytes_interpreted)
if(Monstey_Value)
  message(FATAL_ERROR "Unexpected scope claim: original_instruction_bytes_interpreted")
endif()
set(Monstey_Component "Parent")
set(Monstey_Target "Monstey_SowManagerParentIndependent")
set(Monstey_ExpectedObjects 12)
set(Monstey_MapStem "parent-independent")
set(Monstey_StandaloneOrigin "receipt-review007 f5f25f46;95case standalone product46754/ref8457 are historical origins only")
set(Monstey_Products Monstey_GadbManagerParent Monstey_GadbManagerLeaveProjection Monstey_GadbManagerGuardProjection Monstey_GadbManagerBackend Monstey_GadbManagerFree Monstey_GadbManagerPlacement Monstey_GadbManagerPrimitives)
set(Monstey_Sources
  tests/sow_manager_parent/Monstey_ParentCanonicalServices.cpp
  tests/sow_manager_parent/Monstey_ParentCapture.cpp
  tests/sow_manager_parent/Monstey_ParentCases.cpp
  tests/sow_manager_parent/Monstey_ParentDifferentialMain.cpp
  tests/sow_manager_parent/Monstey_ParentReferenceServices.cpp
  tests/sow_manager_parent/Monstey_ParentSession.cpp
  tests/Monstey_ParentReference.cpp
  tests/Monstey_LeaveProjectionReference.cpp
  tests/Monstey_GuardProjectionReference.cpp
  tests/Monstey_FreeReference.cpp
  tests/Monstey_BackendReference.cpp
  tests/Monstey_PlacementReference.cpp)
function(Monstey_Quote Monstey_Output Monstey_Value)
  string(REPLACE "\\" "\\\\" Monstey_Value "${Monstey_Value}")
  string(REPLACE "\"" "\\\"" Monstey_Value "${Monstey_Value}")
  string(REPLACE "\r" "\\r" Monstey_Value "${Monstey_Value}")
  string(REPLACE "\n" "\\n" Monstey_Value "${Monstey_Value}")
  set(${Monstey_Output} "\"${Monstey_Value}\"" PARENT_SCOPE)
endfunction()
file(GLOB_RECURSE Monstey_Objects LIST_DIRECTORIES false "${Monstey_BuildRoot}/${Monstey_Target}.dir/${Monstey_Config}/*.obj")
list(LENGTH Monstey_Objects Monstey_ObjectCount)
if(NOT Monstey_ObjectCount EQUAL Monstey_ExpectedObjects)
  message(FATAL_ERROR "Expected ${Monstey_ExpectedObjects} freshly compiled objects, got ${Monstey_ObjectCount}")
endif()
file(GLOB_RECURSE Monstey_Tlogs LIST_DIRECTORIES false "${Monstey_BuildRoot}/${Monstey_Target}.dir/${Monstey_Config}/*.tlog")
set(Monstey_LinkFound FALSE)
foreach(Monstey_Tlog IN LISTS Monstey_Tlogs)
  get_filename_component(Monstey_Name "${Monstey_Tlog}" NAME)
  if(Monstey_Name STREQUAL "link.command.1.tlog")
    set(Monstey_LinkFound TRUE)
  endif()
endforeach()
if(NOT Monstey_LinkFound)
  message(FATAL_ERROR "Actual cohort link.command tlog missing")
endif()
set(Monstey_Files "${Monstey_Exe}" "${Monstey_Data}" "${Monstey_Core}"
  "${Monstey_BuildRoot}/${Monstey_MapStem}-${Monstey_Config}.map"
  "${Monstey_Out}/actual-differential.json")
foreach(Monstey_Product IN LISTS Monstey_Products)
  list(APPEND Monstey_Files
    "${Monstey_BuildRoot}/Monstey_Data.dir/${Monstey_Config}/${Monstey_Product}.obj"
    "${Monstey_SourceRoot}/src/${Monstey_Product}.cpp"
    "${Monstey_SourceRoot}/include/${Monstey_Product}.hpp")
endforeach()
foreach(Monstey_Source IN LISTS Monstey_Sources)
  list(APPEND Monstey_Files "${Monstey_SourceRoot}/${Monstey_Source}")
endforeach()
list(APPEND Monstey_Files "${Monstey_SourceRoot}/include/Monstey_FearDbCallable.hpp" ${Monstey_Objects} ${Monstey_Tlogs})
list(REMOVE_DUPLICATES Monstey_Files)
set(Monstey_Pins "")
foreach(Monstey_File IN LISTS Monstey_Files)
  if(NOT EXISTS "${Monstey_File}")
    message(FATAL_ERROR "Actual cohort provenance input missing: ${Monstey_File}")
  endif()
  file(SIZE "${Monstey_File}" Monstey_Size)
  file(SHA256 "${Monstey_File}" Monstey_Sha)
  Monstey_Quote(Monstey_PathJson "${Monstey_File}")
  if(NOT Monstey_Pins STREQUAL "")
    string(APPEND Monstey_Pins ",")
  endif()
  string(APPEND Monstey_Pins "{\"path\":${Monstey_PathJson},\"bytes\":${Monstey_Size},\"sha256\":\"${Monstey_Sha}\"}")
endforeach()
file(WRITE "${Monstey_Out}/cohort-bindings.json"
  "{\"schema\":\"Monstey.ManagerIndependentCohortBindings/1\",\"status\":\"PASS_FRESH_COHORT_DATA_CORE_EXE_OBJECTS\",\"component\":\"${Monstey_Component}\",\"standalone_origin_only\":\"${Monstey_StandaloneOrigin}\",\"standalone_archive_link_inputs\":false,\"component_original_instruction_bytes_interpreted\":false,\"native_original_entrypoint_invoked\":false,\"passive_product_read_trace\":false,\"physical_CPU_OS_ABI_LOCK_qualified\":false,\"higher_or_full_manager_qualified\":false,\"pins\":[${Monstey_Pins}]}\n")
message(STATUS "${Monstey_Component} actual cohort independent differential PASS")
