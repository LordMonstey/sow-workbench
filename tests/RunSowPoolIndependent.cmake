if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
 message(FATAL_ERROR "EXE must name the owned independent SoW test")
endif()
if(NOT DEFINED OUT)
 set(OUT "${CMAKE_CURRENT_BINARY_DIR}/sow-pool-independent-reports")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef Monstey_nonce)
set(Monstey_report "${OUT}/independent-${Monstey_nonce}.json")
if(EXISTS "${Monstey_report}")
 message(FATAL_ERROR "Fresh report path collision")
endif()
execute_process(COMMAND "${EXE}" "${Monstey_report}" RESULT_VARIABLE Monstey_result OUTPUT_VARIABLE Monstey_stdout ERROR_VARIABLE Monstey_stderr TIMEOUT 90)
if(NOT Monstey_result EQUAL 0 OR NOT EXISTS "${Monstey_report}")
 message(FATAL_ERROR "Independent SoW pool test failed: ${Monstey_result}\n${Monstey_stdout}\n${Monstey_stderr}")
endif()
file(READ "${Monstey_report}" Monstey_text)
foreach(Monstey_field status cases checks consumed_faults whole_arena_bytes_compared primitive_read_events raw_predicate_cases stable_view_profile reference_frozen_before_product_read original_executed)
 string(JSON ${Monstey_field} ERROR_VARIABLE Monstey_error GET "${Monstey_text}" ${Monstey_field})
 if(NOT Monstey_error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "Invalid independent report field ${Monstey_field}: ${Monstey_error}")
 endif()
endforeach()
if(NOT status STREQUAL "SOW_INDEPENDENT_DIFFERENTIAL_PASS" OR NOT cases EQUAL 969 OR NOT checks EQUAL 5866 OR NOT consumed_faults EQUAL 239 OR NOT whole_arena_bytes_compared EQUAL 235669336 OR NOT primitive_read_events EQUAL 7656 OR NOT raw_predicate_cases EQUAL 52)
 message(FATAL_ERROR "Independent SoW coverage mismatch: ${Monstey_text}")
endif()
if(original_executed OR NOT stable_view_profile OR NOT reference_frozen_before_product_read)
 message(FATAL_ERROR "Independent SoW execution scope mismatch")
endif()
message(STATUS "${Monstey_stdout}Fresh report: ${Monstey_report}")
