if(NOT DEFINED EXE OR NOT DEFINED OUT)
  message(FATAL_ERROR "EXE and OUT are required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/remaining-independent-${stamp}-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
file(WRITE "${report}.stdout.txt" "${stdout}")
file(WRITE "${report}.stderr.txt" "${stderr}")
if(NOT "${code}" STREQUAL "0")
  message(FATAL_ERROR "Independent remaining-count test failed: ${code}; ${stdout}${stderr}")
endif()
file(READ "${report}" body)
string(JSON status GET "${body}" status)
string(JSON groups GET "${body}" groups)
string(JSON cases GET "${body}" cases)
string(JSON checks GET "${body}" checks)
string(JSON expected GET "${body}" expected_consumed_failures)
string(JSON observed GET "${body}" observed_consumed_failures)
string(JSON shared_reference GET "${body}" reference_uses_product_cached_helper)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 3 OR NOT cases EQUAL 142377 OR NOT checks EQUAL 283853 OR NOT expected EQUAL 1041 OR NOT observed EQUAL expected OR shared_reference)
  message(FATAL_ERROR "Missing exact independent coverage: ${body}")
endif()
message(STATUS "${stdout}; report=${report}")
