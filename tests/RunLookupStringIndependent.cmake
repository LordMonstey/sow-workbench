if(NOT DEFINED EXE OR NOT EXISTS "${EXE}" OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(report "${OUTPUT_ROOT}/independent-${stamp}-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT result EQUAL 0 OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Independent lookup/string failed(${result}): ${output}${error}")
endif()
file(READ "${report}" json)
string(JSON status GET "${json}" status)
string(JSON groups GET "${json}" groups)
string(JSON cases GET "${json}" cases)
string(JSON checks GET "${json}" checks)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 11 OR NOT cases EQUAL 34297 OR NOT checks EQUAL 82331)
 message(FATAL_ERROR "Independent lookup/string coverage changed: ${json}")
endif()
message("${output}Report: ${report}")
