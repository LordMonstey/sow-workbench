if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/category-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" "${nonce}" RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE errors TIMEOUT 90)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "Category test failure ${rc}: ${text} ${errors}")
endif()
file(READ "${report}" body)
string(JSON status GET "${body}" status)
string(JSON groups GET "${body}" groups)
string(JSON cases GET "${body}" cases)
string(JSON checks GET "${body}" checks)
string(JSON faults GET "${body}" faults)
string(JSON events GET "${body}" primitive_events)
string(JSON actual_nonce GET "${body}" nonce)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 4 OR NOT cases EQUAL 80 OR NOT checks EQUAL 1353 OR NOT faults EQUAL 11 OR NOT events EQUAL 881 OR NOT actual_nonce STREQUAL nonce)
 message(FATAL_ERROR "Status/nonce/group mismatch")
endif()
message(STATUS "${text}")
