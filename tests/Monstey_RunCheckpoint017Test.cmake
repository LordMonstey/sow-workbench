# Test-only fresh evidence runner; preserves every prior result.
cmake_minimum_required(VERSION 3.24)
foreach(required TEST_EXE TEST_ROOT TEST_LABEL TEST_MODE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
if(NOT EXISTS "${TEST_EXE}")
  message(FATAL_ERROR "Missing test executable: ${TEST_EXE}")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
while(TRUE)
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
  set(run "${TEST_ROOT}/${TEST_LABEL}-${stamp}-${nonce}")
  if(NOT EXISTS "${run}")
    break()
  endif()
endwhile()
file(MAKE_DIRECTORY "${run}")
message(STATUS "Preserved test run: ${run}")
foreach(kind MESH SKEL ANIX)
  if(DEFINED ${kind}_SHA256 AND NOT "${${kind}_SHA256}" STREQUAL "")
    if(NOT DEFINED ${kind} OR NOT EXISTS "${${kind}}")
      message(FATAL_ERROR "Missing pinned ${kind}")
    endif()
    file(SHA256 "${${kind}}" before_${kind})
    string(TOLOWER "${${kind}_SHA256}" expected_${kind})
    if(NOT before_${kind} STREQUAL expected_${kind})
      message(FATAL_ERROR "${kind} SHA256 differs; retained run: ${run}")
    endif()
  endif()
endforeach()
function(monstey_run_process label executable)
  execute_process(COMMAND "${executable}" ${ARGN} RESULT_VARIABLE status
    OUTPUT_FILE "${run}/${label}.stdout.log" ERROR_FILE "${run}/${label}.stderr.log" TIMEOUT 540)
  if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "${label} failed (${status}); inspect ${run}")
  endif()
endfunction()
if(TEST_MODE STREQUAL "plain")
  monstey_run_process(test "${TEST_EXE}")
elseif(TEST_MODE STREQUAL "directory")
  monstey_run_process(test "${TEST_EXE}" "${run}/output")
elseif(TEST_MODE STREQUAL "file")
  monstey_run_process(test "${TEST_EXE}" "${run}/output.bin")
elseif(TEST_MODE STREQUAL "default")
  monstey_run_process(test "${TEST_EXE}" --test "${run}/report.json" ${SKELS})
elseif(TEST_MODE STREQUAL "runtime")
  if(NOT DEFINED SETUP_EXE OR NOT EXISTS "${SETUP_EXE}")
    message(FATAL_ERROR "Missing runtime synthetic setup executable")
  endif()
  monstey_run_process(fixture "${SETUP_EXE}" "${run}/fixtures")
  monstey_run_process(test "${TEST_EXE}" "${run}/output"
    "${run}/fixtures/synthetic.mesh" "${run}/fixtures/synthetic.skel" "${run}/fixtures/synthetic.anix")
elseif(TEST_MODE STREQUAL "animation_actual")
  monstey_run_process(test "${TEST_EXE}" --actual "${MESH}" "${SKEL}" "${ANIX}" "${CLIP}" "${run}/output")
elseif(TEST_MODE STREQUAL "api_actual")
  monstey_run_process(test "${TEST_EXE}" "${run}/output" "${MESH}" "${SKEL}" "${ANIX}" "${CLIP}")
elseif(TEST_MODE STREQUAL "window_actual")
  monstey_run_process(test "${TEST_EXE}" "${run}/output" "${MESH}" "${SKEL}" "${ANIX}")
elseif(TEST_MODE STREQUAL "layout")
  if(DEFINED BLEND_TEMPLATE AND NOT "${BLEND_TEMPLATE}" STREQUAL "")
    monstey_run_process(test "${TEST_EXE}" "${run}/output" --candidate "${BLEND_TEMPLATE}")
  else()
    monstey_run_process(test "${TEST_EXE}" "${run}/output" --candidate)
  endif()
elseif(TEST_MODE STREQUAL "channels")
  monstey_run_process(test "${TEST_EXE}" "${MESH}" "${SKEL}")
else()
  message(FATAL_ERROR "Unknown TEST_MODE: ${TEST_MODE}")
endif()
foreach(kind MESH SKEL ANIX)
  if(DEFINED before_${kind})
    file(SHA256 "${${kind}}" after_${kind})
    if(NOT after_${kind} STREQUAL before_${kind})
      message(FATAL_ERROR "Input ${kind} changed; retained run: ${run}")
    endif()
  endif()
endforeach()
message(STATUS "${TEST_LABEL} passed; evidence retained at ${run}")