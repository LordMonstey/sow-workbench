if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
if(EXISTS "${OUT}/report.json" OR EXISTS "${OUT}/stderr.txt")
 message(FATAL_ERROR "Refusing to overwrite framed test evidence")
endif()
execute_process(COMMAND "${EXE}" RESULT_VARIABLE status OUTPUT_FILE "${OUT}/report.json" ERROR_FILE "${OUT}/stderr.txt")
if(NOT status EQUAL 0)
 message(FATAL_ERROR "Framed test failed: ${status}; see ${OUT}")
endif()
file(READ "${OUT}/report.json" result)
string(JSON failures GET "${result}" failed)
if(NOT failures EQUAL 0)
 message(FATAL_ERROR "Framed report contains failures")
endif()
