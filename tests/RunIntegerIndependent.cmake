if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/integer-${nonce}.json")
if(EXISTS "${report}")
 message(FATAL_ERROR "Fresh report collision")
endif()
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT code EQUAL 0 OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Integer independent failed: ${code} ${stdout} ${stderr}")
endif()
file(READ "${report}" data)
string(JSON passed GET "${data}" passed)
string(JSON groups GET "${data}" groups)
string(JSON cases GET "${data}" cases)
string(JSON checks GET "${data}" checks)
if(NOT passed OR NOT groups EQUAL 10 OR NOT cases EQUAL 45960 OR NOT checks EQUAL 91920)
 message(FATAL_ERROR "Independent coverage differs ${groups}/${cases}/${checks}")
endif()
message(STATUS "${stdout}")
