if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "Explicit EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef Monstey_Id)
set(Monstey_Report "${OUT}/cleanup-independent-${Monstey_Id}.json")
execute_process(COMMAND "${EXE}" "${Monstey_Report}" RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Output ERROR_VARIABLE Monstey_Error TIMEOUT 60)
if(NOT Monstey_Result EQUAL 0)
 message(FATAL_ERROR "${Monstey_Output}${Monstey_Error}")
endif()
file(READ "${Monstey_Report}" Monstey_Json)
string(JSON Monstey_Status GET "${Monstey_Json}" status)
string(JSON Monstey_Cases GET "${Monstey_Json}" cases)
string(JSON Monstey_Checks GET "${Monstey_Json}" checks)
if(NOT Monstey_Status STREQUAL "PASS" OR NOT Monstey_Cases EQUAL 2226 OR NOT Monstey_Checks EQUAL 8898)
 message(FATAL_ERROR "Unexpected independent cleanup result")
endif()
message(STATUS "${Monstey_Output}")
