file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(run "${OUTPUT_ROOT}/independent-${nonce}")
file(MAKE_DIRECTORY "${run}")
execute_process(COMMAND "${TEST_EXE}" "${run}/report.json" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 45)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Independent native GUI regression failed: ${result}\n${stdout}\n${stderr}")
endif()
file(READ "${run}/report.json" text)
foreach(key pass groups assertions owned_hidden_UI fixture_records selected_page_offset selected_record_row selected_field_row actual_project_history_and_source_preserved no_CUA_or_Game)
 string(JSON ${key} GET "${text}" ${key})
endforeach()
if(NOT pass OR NOT groups EQUAL 4 OR NOT assertions EQUAL 318 OR NOT owned_hidden_UI OR NOT fixture_records EQUAL 270 OR NOT selected_page_offset EQUAL 250 OR NOT selected_record_row EQUAL 5 OR NOT selected_field_row EQUAL 1 OR NOT actual_project_history_and_source_preserved OR NOT no_CUA_or_Game)
 message(FATAL_ERROR "Independent GUI coverage changed: ${text}")
endif()
message(STATUS "${stdout}Report ${run}/report.json")
