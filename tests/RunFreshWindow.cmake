if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "Need executable and output root")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
execute_process(COMMAND "${TEST_EXE}" "${run}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
message("${output}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native texture window tests failed: ${error}")
endif()
if(NOT EXISTS "${run}/report.json")
  message(FATAL_ERROR "Native texture window report missing")
endif()