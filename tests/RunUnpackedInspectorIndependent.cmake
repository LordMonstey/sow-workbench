foreach(required IN ITEMS GEN EXE OUTPUT_ROOT)
 if(NOT DEFINED ${required})
  message(FATAL_ERROR "Missing ${required}")
 endif()
endforeach()
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(root "${OUTPUT_ROOT}/${stamp}-${nonce}")
set(fixtures "${root}/fixtures")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${GEN}" "${fixtures}" RESULT_VARIABLE generated OUTPUT_VARIABLE genout ERROR_VARIABLE generr)
message("${genout}${generr}")
if(NOT generated EQUAL 0)
 message(FATAL_ERROR "Independent fixture generation failed")
endif()
set(report "${root}/report.json")
execute_process(COMMAND "${EXE}" "${fixtures}/expected-fixtures-001.json" "${root}" "${report}" RESULT_VARIABLE tested OUTPUT_VARIABLE testout ERROR_VARIABLE testerr)
message("${testout}${testerr}")
if(NOT tested EQUAL 0 OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Independent unpacked inspector failed")
endif()
file(READ "${report}" body)
string(JSON status GET "${body}" status)
string(JSON cases GET "${body}" cases)
string(JSON checks GET "${body}" checks)
string(JSON faults GET "${body}" expected_faults)
if(NOT status STREQUAL "PASS" OR NOT cases EQUAL 116 OR NOT checks EQUAL 2113 OR NOT faults EQUAL 50)
 message(FATAL_ERROR "Exact independent coverage mismatch")
endif()
