if(NOT DEFINED EXE OR NOT EXISTS "${EXE}" OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT are required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/probe-${stamp}-${nonce}.json")
if(MODE STREQUAL "FILE")
 execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
else()
 execute_process(COMMAND "${EXE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
endif()
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Native getter test failed(${result}): ${output}${error}")
endif()
if(MODE STREQUAL "TEXT")
 string(FIND "${output}" "${EXPECTED_TEXT}" position)
 if(position EQUAL -1)
  message(FATAL_ERROR "Required executed coverage missing: ${output}")
 endif()
 file(WRITE "${report}.log" "${output}${error}")
else()
 if(MODE STREQUAL "FILE")
  file(READ "${report}" body)
 else()
  set(body "${output}")
  file(WRITE "${report}" "${body}")
 endif()
 string(JSON passed ERROR_VARIABLE pass_error GET "${body}" pass)
 if(pass_error)
  string(JSON status GET "${body}" status)
  if(NOT status STREQUAL "PASS")
   message(FATAL_ERROR "Native report did not pass: ${body}")
  endif()
 elseif(NOT passed)
  message(FATAL_ERROR "Native report did not pass: ${body}")
 endif()
 if(NOT DEFINED CHECK_KEY)
  set(CHECK_KEY checks)
 endif()
 string(JSON groups GET "${body}" groups)
 string(JSON cases GET "${body}" cases)
 string(JSON checks GET "${body}" "${CHECK_KEY}")
 if(NOT groups EQUAL GROUPS OR NOT cases EQUAL CASES OR NOT checks EQUAL CHECKS)
  message(FATAL_ERROR "Native coverage changed: ${body}")
 endif()
endif()
message(STATUS "${output}; report=${report}")
