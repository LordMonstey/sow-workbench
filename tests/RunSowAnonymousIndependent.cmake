if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
 message(FATAL_ERROR "EXE must name the independent anonymous-record test")
endif()
if(NOT DEFINED OUT)
 set(OUT "${CMAKE_CURRENT_BINARY_DIR}/anonymous-independent-reports")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef Monstey_nonce)
set(Monstey_report "${OUT}/anonymous-${Monstey_nonce}.json")
if(EXISTS "${Monstey_report}")
 message(FATAL_ERROR "Fresh report collision")
endif()
execute_process(COMMAND "${EXE}" "${Monstey_report}" RESULT_VARIABLE Monstey_result OUTPUT_VARIABLE Monstey_stdout ERROR_VARIABLE Monstey_stderr TIMEOUT 90)
if(NOT Monstey_result EQUAL 0 OR NOT EXISTS "${Monstey_report}")
 message(FATAL_ERROR "Independent anonymous test failed: ${Monstey_result}\n${Monstey_stdout}\n${Monstey_stderr}")
endif()
file(READ "${Monstey_report}" Monstey_text)
foreach(Monstey_field status cases checks fault_cases whole_arena_bytes primitive_read_events stable_view_profile reference_frozen_before_product_read original_executed)
 string(JSON ${Monstey_field} ERROR_VARIABLE Monstey_error GET "${Monstey_text}" ${Monstey_field})
 if(NOT Monstey_error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "Invalid anonymous report field ${Monstey_field}: ${Monstey_error}")
 endif()
endforeach()
if(NOT status STREQUAL "SOW_ANONYMOUS_INDEPENDENT_PASS" OR NOT cases EQUAL 56 OR NOT checks EQUAL 336 OR NOT fault_cases EQUAL 15 OR NOT whole_arena_bytes EQUAL 6623303 OR NOT primitive_read_events EQUAL 1573)
 message(FATAL_ERROR "Independent anonymous coverage mismatch: ${Monstey_text}")
endif()
if(original_executed OR NOT stable_view_profile OR NOT reference_frozen_before_product_read)
 message(FATAL_ERROR "Independent anonymous execution scope mismatch")
endif()
message(STATUS "${Monstey_stdout}Fresh report: ${Monstey_report}")
