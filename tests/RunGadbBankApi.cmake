if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT OR NOT DEFINED BASELINE_CATALOG)
  message(FATAL_ERROR "TEST_EXE, OUTPUT_ROOT and BASELINE_CATALOG are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
execute_process(COMMAND "${TEST_EXE}" "${run}" "${BASELINE_CATALOG}"
  RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 120)
file(WRITE "${run}.process.log" "exit=${code}\n${stdout}\n${stderr}\n")
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Native bank API failed: ${run}.process.log")
endif()
file(READ "${run}/report.json" report)
string(JSON status GET "${report}" status)
string(JSON count GET "${report}" count)
string(JSON catalog GET "${report}" catalog_operations)
string(JSON preserved GET "${report}" previous_descriptors_unchanged)
string(JSON direct_cases GET "${report}" direct_rejection_cases)
string(JSON runtime_cases GET "${report}" runtime_rejection_cases)
if(NOT status STREQUAL "PASS" OR NOT count EQUAL 11 OR NOT catalog EQUAL 227 OR NOT preserved EQUAL 223 OR NOT direct_cases EQUAL 16 OR NOT runtime_cases EQUAL 7)
  message(FATAL_ERROR "Native bank API acceptance incomplete")
endif()
message(STATUS "Native bank API11 synthetic groups PASS;16 direct/7 runtime rejections;223 descriptors preserved")