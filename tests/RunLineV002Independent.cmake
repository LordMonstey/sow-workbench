if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "Explicit executable/output root required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(TIMESTAMP Monstey_Stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef Monstey_Nonce)
set(Monstey_Report "${OUT}/report-${Monstey_Stamp}-${Monstey_Nonce}.json")
execute_process(COMMAND "${EXE}" "${Monstey_Report}" RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Out ERROR_VARIABLE Monstey_Err)
if(NOT Monstey_Result EQUAL 0)
 message(FATAL_ERROR "Line v002 independent regression failed: ${Monstey_Out}${Monstey_Err}")
endif()
file(READ "${Monstey_Report}" Monstey_Json)
string(JSON Monstey_Status GET "${Monstey_Json}" status)
string(JSON Monstey_Cases GET "${Monstey_Json}" cases)
string(JSON Monstey_Checks GET "${Monstey_Json}" checks)
string(JSON Monstey_Faults GET "${Monstey_Json}" fault_cases)
if(NOT Monstey_Status STREQUAL "PASS" OR NOT Monstey_Cases EQUAL 1526 OR NOT Monstey_Checks EQUAL 10454 OR NOT Monstey_Faults EQUAL 531)
 message(FATAL_ERROR "Unexpected line v002 status or counters")
endif()
message(STATUS "${Monstey_Out}")
