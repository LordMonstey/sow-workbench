if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${OUTPUT_ROOT}/ctor-${nonce}.json")
if(EXISTS "${report}")
 message(FATAL_ERROR "Fresh regression report collision")
endif()
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
if(NOT result STREQUAL "0")
 message(FATAL_ERROR "Native constructor regression failed: ${result}\n${stdout}\n${stderr}")
endif()
file(READ "${report}" json)
string(JSON status GET "${json}" status)
string(JSON groups GET "${json}" groups)
string(JSON cases GET "${json}" cases)
string(JSON checks GET "${json}" checks)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 1 OR NOT cases EQUAL 1 OR checks LESS 4)
 message(FATAL_ERROR "Constructor regression coverage mismatch")
endif()
message(STATUS "${stdout}")
