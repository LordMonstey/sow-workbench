if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
 message(FATAL_ERROR "EXE must name the built independent owned-bank test")
endif()
if(NOT DEFINED OUT)
 set(OUT "${CMAKE_CURRENT_BINARY_DIR}/reports")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/bank-activation-independent-${nonce}.json")
if(EXISTS "${report}")
 message(FATAL_ERROR "A new independent report is required")
endif()
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Independent bank activation failed: ${result}\n${output}\n${error}")
endif()
file(READ "${report}" text)
string(JSON status GET "${text}" status)
string(JSON groups GET "${text}" groups)
string(JSON cases GET "${text}" cases)
string(JSON checks GET "${text}" checks)
string(JSON ranges GET "${text}" range_faults)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 14 OR NOT cases EQUAL 5310 OR NOT checks EQUAL 10700 OR NOT ranges EQUAL 151)
 message(FATAL_ERROR "Independent coverage differs: ${text}")
endif()
message(STATUS "${text}")