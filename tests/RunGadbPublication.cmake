if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT are required")
endif()
file(MAKE_DIRECTORY "${OUT}")
if(EXISTS "${OUT}/owner-tests.json" OR EXISTS "${OUT}/owner-tests.stderr.txt")
 message(FATAL_ERROR "Refusing to overwrite owner test evidence")
endif()
execute_process(COMMAND "${EXE}" RESULT_VARIABLE status
 OUTPUT_FILE "${OUT}/owner-tests.json" ERROR_FILE "${OUT}/owner-tests.stderr.txt")
if(NOT status EQUAL 0)
 message(FATAL_ERROR "SoW publication owning tests failed: ${status}; see ${OUT}")
endif()
file(READ "${OUT}/owner-tests.json" report)
string(JSON failures GET "${report}" failed)
if(NOT failures EQUAL 0)
 message(FATAL_ERROR "SoW publication owning test report records failures")
endif()
