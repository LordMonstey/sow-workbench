if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "EXE and OUTPUT_ROOT are required")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" nonce)
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(report "${OUTPUT_ROOT}/${stamp}-${nonce}.json")
set(arguments)
if(DEFINED FIRST_ARGUMENT)
  list(APPEND arguments "${FIRST_ARGUMENT}")
endif()
execute_process(COMMAND "${EXE}" ${arguments} "${report}" RESULT_VARIABLE status
  OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
message("${output}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Qualified native component failed: ${error}")
endif()
file(READ "${report}" content)
string(JSON passed ERROR_VARIABLE pass_error GET "${content}" pass)
if(pass_error)
  string(JSON passed ERROR_VARIABLE pass_error GET "${content}" passed)
endif()
if(pass_error)
  string(JSON result ERROR_VARIABLE status_error GET "${content}" status)
  if(status_error OR NOT result STREQUAL "PASS")
    message(FATAL_ERROR "Qualified native component report did not pass")
  endif()
elseif(NOT passed)
  message(FATAL_ERROR "Qualified native component report did not pass")
endif()