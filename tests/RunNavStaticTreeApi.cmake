if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT OR NOT DEFINED BASELINE_CATALOG)
  message(FATAL_ERROR "TEST_EXE, OUTPUT_ROOT and BASELINE_CATALOG are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
execute_process(COMMAND "${TEST_EXE}" "${run}" "${BASELINE_CATALOG}"
  RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 120)
file(WRITE "${run}.process.log" "exit=${code}\n${stdout}\n${stderr}\n")
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Static-tree API failed: ${run}.process.log")
endif()
file(READ "${run}/report.json" report)
string(JSON status GET "${report}" status)
string(JSON groups GET "${report}" groups)
string(JSON pages GET "${report}" page_cases)
string(JSON negative GET "${report}" negative_cases)
string(JSON runtime_negative GET "${report}" runtime_negative_cases)
string(JSON catalog GET "${report}" catalog_operations)
string(JSON preserved GET "${report}" old_descriptors_exact)
string(JSON envelope GET "${report}" maximum_MCP_envelope_bytes)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 11 OR NOT pages EQUAL 12 OR
   NOT negative EQUAL 17 OR NOT runtime_negative EQUAL 6 OR NOT catalog EQUAL 227 OR
   NOT preserved EQUAL 224 OR envelope GREATER_EQUAL 65536)
  message(FATAL_ERROR "Static-tree API synthetic acceptance incomplete")
endif()
message(STATUS "Native static-tree API11 synthetic groups PASS;224 prior descriptors preserved")
