if(NOT DEFINED REPORT_ROOT)
 message(FATAL_ERROR "REPORT_ROOT is required")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(REPORT_DIRECTORY "${REPORT_ROOT}/${stamp}-${nonce}")
if(EXISTS "${REPORT_DIRECTORY}")
 message(FATAL_ERROR "Fresh report directory required")
endif()
execute_process(COMMAND "${TEST_EXE}" "${REPORT_DIRECTORY}" "${BASELINE}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "${code}: ${out} ${err}")
endif()
file(READ "${REPORT_DIRECTORY}/report.json" j)
foreach(pair status groups cases checks rejections pages)
 string(JSON ${pair} GET "${j}" ${pair})
endforeach()
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 4 OR NOT cases EQUAL 107 OR NOT checks EQUAL 7154 OR NOT rejections EQUAL 38 OR NOT pages EQUAL 520)
 message(FATAL_ERROR "Independent exact coverage differs")
endif()
message(STATUS "PASS4groups107cases7154checks38rejections520pages")
