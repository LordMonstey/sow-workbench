if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP NOW "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef SUFFIX)
set(REPORT "${OUTPUT_ROOT}/comparator-${NOW}-${SUFFIX}.json")
execute_process(COMMAND "${EXE}" "${REPORT}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR TIMEOUT 110)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "Comparator regression failed: ${RESULT} ${OUT} ${ERR}")
endif()
file(READ "${REPORT}" BODY)
string(JSON STATUS GET "${BODY}" status)
string(JSON GROUPS GET "${BODY}" groups)
string(JSON CASES GET "${BODY}" cases)
string(JSON CHECKS GET "${BODY}" checks)
if(NOT STATUS STREQUAL "PASS" OR NOT GROUPS EQUAL 12 OR NOT CASES EQUAL 26 OR NOT CHECKS EQUAL 45)
 message(FATAL_ERROR "Comparator regression counters/status mismatch")
endif()
foreach(FIELD IN ITEMS native_original_entrypoint_invoked original_image_loaded original_instruction_bytes_interpreted)
 string(JSON VALUE GET "${BODY}" "${FIELD}")
 if(VALUE)
  message(FATAL_ERROR "Unexpected original execution/interpretation: ${FIELD}")
 endif()
endforeach()
message(STATUS "${OUT}")
