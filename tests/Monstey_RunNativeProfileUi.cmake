if(NOT DEFINED UI_EXE OR NOT DEFINED FIXTURE_EXE OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "UI_EXE, FIXTURE_EXE and OUTPUT_ROOT are required")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
file(TO_NATIVE_PATH "${run}" run_native)
set(run "${run_native}")
if(EXISTS "${run}")
  message(FATAL_ERROR "Fresh profile UI run exists")
endif()
file(MAKE_DIRECTORY "${run}")
file(TO_NATIVE_PATH "${run}/fixtures" fixture_root)
execute_process(COMMAND "${FIXTURE_EXE}" "${fixture_root}" RESULT_VARIABLE code
  OUTPUT_FILE "${run}/fixtures.log" ERROR_FILE "${run}/fixtures-error.log" TIMEOUT 30)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Native synthetic profile fixture generation failed")
endif()
file(READ "${run}/fixtures/cases.json" cases)
string(JSON count LENGTH "${cases}")
if(DEFINED CASE_LIMIT AND CASE_LIMIT LESS count)
  set(count "${CASE_LIMIT}")
endif()
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  string(JSON name GET "${cases}" ${index} name)
  string(JSON project GET "${cases}" ${index} project)
  string(JSON arguments GET "${cases}" ${index} arguments)
  file(TO_NATIVE_PATH "${run}/${name}.json" report)
  execute_process(COMMAND "${UI_EXE}" --smoke-native-profile --database "${project}"
    --smoke-arguments "${arguments}" --smoke-report "${report}" --settings "${run}/${name}.settings.json"
    RESULT_VARIABLE code OUTPUT_FILE "${run}/${name}.process.log" ERROR_FILE "${run}/${name}.error.log" TIMEOUT 45)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Native profile UI case ${name} failed (${code}); retained ${run}")
  endif()
  file(READ "${report}" result)
  string(JSON status GET "${result}" status)
  if(NOT status STREQUAL "PASS")
    message(FATAL_ERROR "Native profile UI report ${name} failed; retained ${run}")
  endif()
endforeach()
file(WRITE "${run}/result.json" "{\"status\":\"PASS\",\"cases\":${count},\"native_fixtures\":true}\n")
message(STATUS "Native profile UI ${count} cases PASS: ${run}")
