if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
 message(FATAL_ERROR "EXE must name the built independent packed regression")
endif()
if(NOT DEFINED OUT)
 set(OUT "${CMAKE_CURRENT_BINARY_DIR}/packed-independent")
endif()
if(NOT MODE STREQUAL "epoch" AND NOT MODE STREQUAL "layout")
 message(FATAL_ERROR "MODE must be epoch or layout")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/packed-${MODE}-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Independent packed regression failed ${result}\n${output}\n${error}")
endif()
file(READ "${report}" text)
foreach(field status groups cases checks owned_bytes_compared)
 string(JSON ${field} GET "${text}" ${field})
endforeach()
if(NOT status STREQUAL "PASS")
 message(FATAL_ERROR "Independent parser did not pass: ${text}")
endif()
if(MODE STREQUAL "epoch")
 if(NOT groups EQUAL 4 OR NOT cases EQUAL 287 OR NOT checks EQUAL 1416 OR NOT owned_bytes_compared EQUAL 1622994)
  message(FATAL_ERROR "Independent epoch coverage mismatch: ${text}")
 endif()
else()
 string(JSON written GET "${text}" native_written_bytes_compared)
 string(JSON faults GET "${text}" consumed_fault_cases)
 if(NOT groups EQUAL 9 OR NOT cases EQUAL 2380 OR NOT checks EQUAL 17052 OR NOT owned_bytes_compared EQUAL 4411897 OR NOT written EQUAL 4404729 OR NOT faults EQUAL 5)
  message(FATAL_ERROR "Independent layout coverage mismatch: ${text}")
 endif()
endif()
message(STATUS "${text}")
