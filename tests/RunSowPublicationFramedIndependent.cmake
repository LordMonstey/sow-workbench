if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${EXE}" RESULT_VARIABLE Monstey_Code OUTPUT_VARIABLE Monstey_Result ERROR_VARIABLE Monstey_Error)
file(WRITE "${OUT}/result.json" "${Monstey_Result}")
file(WRITE "${OUT}/stderr.txt" "${Monstey_Error}")
if(NOT Monstey_Code EQUAL 0)
 message(FATAL_ERROR "Framed independent check failed: ${Monstey_Error}")
endif()
string(JSON Monstey_Status GET "${Monstey_Result}" status)
if(NOT Monstey_Status STREQUAL "PASS")
 message(FATAL_ERROR "Independent result status is not PASS")
endif()
