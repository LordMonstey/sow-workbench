if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
 message(FATAL_ERROR "EXE must name the built independent Open regression")
endif()
if(NOT DEFINED OUT)
 set(OUT "${CMAKE_CURRENT_BINARY_DIR}/open-independent")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/open-independent-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Independent Open regression failed ${result}\n${output}\n${error}")
endif()
file(READ "${report}" text)
foreach(field status groups cases checks consumed_faults)
 string(JSON ${field} GET "${text}" ${field})
endforeach()
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 7 OR NOT cases EQUAL 2258 OR NOT checks EQUAL 77566 OR NOT consumed_faults EQUAL 3)
 message(FATAL_ERROR "Independent Open coverage mismatch: ${text}")
endif()
message(STATUS "${text}")
