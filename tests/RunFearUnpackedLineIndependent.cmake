if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef Monstey_Run)
set(Monstey_Report "${OUT}/independent-${Monstey_Run}.json")
execute_process(COMMAND "${EXE}" "${Monstey_Report}" RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Stdout ERROR_VARIABLE Monstey_Stderr TIMEOUT 90)
if(NOT Monstey_Result EQUAL 0)
 message(FATAL_ERROR "${Monstey_Stdout}${Monstey_Stderr}")
endif()
file(READ "${Monstey_Report}" Monstey_Json)
string(JSON Monstey_Status GET "${Monstey_Json}" status)
if(NOT Monstey_Status STREQUAL "PASS")
 message(FATAL_ERROR "Independent report did not pass")
endif()
message(STATUS "${Monstey_Stdout}")
