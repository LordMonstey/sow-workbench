file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef NONCE)
execute_process(COMMAND "${EXE}" "${OUT}/nextkey-${NONCE}.json" RESULT_VARIABLE RC OUTPUT_VARIABLE LOG ERROR_VARIABLE ERR)
if(NOT RC EQUAL 0)
 message(FATAL_ERROR "Independent NextKey failed: ${RC} ${LOG} ${ERR}")
endif()
file(READ "${OUT}/nextkey-${NONCE}.json" JSON)
string(JSON GROUPS GET "${JSON}" groups)
string(JSON CASES GET "${JSON}" cases)
string(JSON CHECKS GET "${JSON}" checks)
string(JSON PASSED GET "${JSON}" passed)
if(NOT PASSED OR NOT GROUPS EQUAL 5 OR NOT CASES EQUAL 12078 OR NOT CHECKS EQUAL 12696)
 message(FATAL_ERROR "Independent NextKey result contract differs")
endif()
message(STATUS "${LOG}")
