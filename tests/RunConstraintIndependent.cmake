if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "Explicit executable/output root required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP Monstey_Stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef Monstey_Nonce)
set(Monstey_Report "${OUTPUT_ROOT}/report-${Monstey_Stamp}-${Monstey_Nonce}.json")
execute_process(COMMAND "${EXE}" "${Monstey_Report}" RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Out ERROR_VARIABLE Monstey_Err)
if(NOT Monstey_Result EQUAL 0)
 message(FATAL_ERROR "Independent constraint regression failed: ${Monstey_Out}${Monstey_Err}")
endif()
file(READ "${Monstey_Report}" Monstey_Json)
string(JSON Monstey_Status GET "${Monstey_Json}" status)
if(NOT Monstey_Status STREQUAL "PASS")
 message(FATAL_ERROR "Independent constraint result is not PASS")
endif()
message(STATUS "${Monstey_Out}")