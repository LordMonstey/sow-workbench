if(NOT EXISTS "${EXE}")
  message(FATAL_ERROR "Missing owned test executable")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef NONCE)
set(REPORT "${OUT}/reference-${NONCE}.json")
execute_process(COMMAND "${EXE}" "${REPORT}" RESULT_VARIABLE RC OUTPUT_VARIABLE LOG ERROR_VARIABLE ERR)
if(NOT RC EQUAL 0)
  message(FATAL_ERROR "Reference test failed: ${RC} ${LOG} ${ERR}")
endif()
file(READ "${REPORT}" JSON)
string(JSON PASSED GET "${JSON}" passed)
string(JSON GROUPS GET "${JSON}" groups)
string(JSON CASES GET "${JSON}" cases)
string(JSON CHECKS GET "${JSON}" checks)
if(NOT PASSED OR NOT GROUPS EQUAL 9 OR NOT CASES EQUAL 24777 OR NOT CHECKS EQUAL 42269)
  message(FATAL_ERROR "Reference result contract mismatch")
endif()
message(STATUS "${LOG}")
