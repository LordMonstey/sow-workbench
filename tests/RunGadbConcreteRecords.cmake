if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "Required: EXE and OUT")
endif()
if(NOT EXISTS "${EXE}")
 message(FATAL_ERROR "Owned concrete-record test executable missing")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(run "${OUT}/concrete-records-${nonce}")
if(EXISTS "${run}")
 message(FATAL_ERROR "Fresh result directory collision")
endif()
file(MAKE_DIRECTORY "${run}")
execute_process(COMMAND "${EXE}" RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 90)
file(WRITE "${run}/stdout.json" "${stdout}")
file(WRITE "${run}/stderr.log" "${stderr}")
file(WRITE "${run}/process.txt" "exit=${code}\nnonce=${nonce}\n")
if(NOT code STREQUAL "0")
 message(FATAL_ERROR "Concrete-record test failed: ${code}; ${run}")
endif()
foreach(key cases checks faults events arena_bytes failed)
 string(JSON ${key} ERROR_VARIABLE error GET "${stdout}" "${key}")
 if(NOT error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "Invalid concrete-record report ${key}: ${error}")
 endif()
endforeach()
if(NOT cases EQUAL 2934 OR NOT checks EQUAL 8495 OR NOT faults EQUAL 9 OR NOT failed EQUAL 0)
 message(FATAL_ERROR "Required concrete-record coverage incomplete: ${stdout}")
endif()
message(STATUS "${stdout} Fresh process output directory: ${run}")
