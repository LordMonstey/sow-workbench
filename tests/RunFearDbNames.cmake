if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP STAMP "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef NONCE)
set(REPORT "${OUTPUT_ROOT}/names-${STAMP}-${NONCE}.json")
execute_process(COMMAND "${EXE}" "${REPORT}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "Names suite failed (${RESULT}): ${OUT}${ERR}")
endif()
file(READ "${REPORT}" JSON)
string(JSON PASSED GET "${JSON}" passed)
string(JSON GROUPS GET "${JSON}" groups)
string(JSON CASES GET "${JSON}" cases)
string(JSON CHECKS GET "${JSON}" checks)
if(NOT PASSED OR NOT GROUPS EQUAL 8 OR NOT CASES EQUAL 39412 OR NOT CHECKS EQUAL 78789)
 message(FATAL_ERROR "Names coverage changed: ${GROUPS}/${CASES}/${CHECKS}")
endif()
message(STATUS "${OUT}Report: ${REPORT}")
