if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "TEST_EXE and OUTPUT_ROOT are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
if(EXISTS "${run}")
  message(FATAL_ERROR "Fresh test directory unexpectedly exists")
endif()
execute_process(COMMAND "${TEST_EXE}" "${run}" RESULT_VARIABLE result
  OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 240)
file(WRITE "${run}.process.log" "exit=${result}\n${stdout}\n${stderr}\n")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native writer guard tests failed: ${result}; retained ${run}.process.log")
endif()
file(READ "${run}/result.json" report)
string(JSON status GET "${report}" status)
string(JSON count GET "${report}" count)
if(NOT status STREQUAL "PASS" OR count LESS 23)
  message(FATAL_ERROR "Native writer guard test report is incomplete")
endif()
message(STATUS "Native writer guard ${count} groups PASS: ${run}")
