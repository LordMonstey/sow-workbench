if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "Explicit EXE and OUTPUT_ROOT required")
endif()
string(TIMESTAMP stamp "%Y%m%d%H%M%S" UTC)
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(report "${OUTPUT_ROOT}/resource-independent-${stamp}-${nonce}.log")
if(EXISTS "${report}")
 message(FATAL_ERROR "New output required")
endif()
execute_process(COMMAND "${EXE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
file(WRITE "${report}" "${output}${error}")
string(STRIP "${output}" output)
if(NOT result EQUAL 0 OR NOT output STREQUAL "PASS resource_independent groups=6 cases=44697 checks=89394")
 message(FATAL_ERROR "Resource independent regression failed: ${result}: ${output}${error}")
endif()
message(STATUS "${output}")