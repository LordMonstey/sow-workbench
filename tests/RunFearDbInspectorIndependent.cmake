if(NOT DEFINED EXE OR NOT DEFINED CLI OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "Explicit owned test executable, frozen CLI and output root required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(output "${OUTPUT_ROOT}/independent-${stamp}-${nonce}")
execute_process(COMMAND "${EXE}" "${CLI}" "${output}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("${out}")
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Independent CLI returned ${code}; candidate discrepancy or harness failure. Artifacts: ${output}\n${err}")
endif()
