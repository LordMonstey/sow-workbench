if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "TEST_EXE and OUTPUT_ROOT are required")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
execute_process(COMMAND "${TEST_EXE}" "${run}" RESULT_VARIABLE status
  OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
message("${output}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native dark theme tests failed: ${error}")
endif()
file(READ "${run}/report.json" report)
string(JSON result GET "${report}" status)
if(NOT result STREQUAL "PASS")
  message(FATAL_ERROR "Native dark theme report failed: ${run}")
endif()