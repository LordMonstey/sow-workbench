if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${EXE}" RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Output ERROR_VARIABLE Monstey_Error)
file(WRITE "${OUT}/result.json" "${Monstey_Output}")
file(WRITE "${OUT}/stderr.txt" "${Monstey_Error}")
if(NOT Monstey_Result EQUAL 0)
 message(FATAL_ERROR "category lookup: ${Monstey_Result}: ${Monstey_Error}")
endif()
message(STATUS "${Monstey_Output}")
