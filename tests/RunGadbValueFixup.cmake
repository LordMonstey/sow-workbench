if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
 message(FATAL_ERROR "EXE must name the built synthetic value-fixup test")
endif()
if(NOT DEFINED OUT)
 set(OUT "${CMAKE_CURRENT_BINARY_DIR}/value-fixup-reports")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/value-fixup-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Synthetic value-fixup regression failed ${result}\n${output}\n${error}")
endif()
file(READ "${report}" text)
foreach(field status groups cases checks consumed_faults)
 string(JSON ${field} GET "${text}" ${field})
endforeach()
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 6 OR NOT cases EQUAL 2900 OR NOT checks EQUAL 2909 OR NOT consumed_faults EQUAL 6)
 message(FATAL_ERROR "Value-fixup coverage mismatch: ${text}")
endif()
message(STATUS "${text}")
