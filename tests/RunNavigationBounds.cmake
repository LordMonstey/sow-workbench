if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "EXE and OUTPUT_ROOT are required")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" nonce)
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(report "${OUTPUT_ROOT}/${stamp}-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE status
  OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
message("${output}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Navigation bounds failed: ${error}")
endif()
file(READ "${report}" content)
string(JSON result GET "${content}" status)
if(NOT result STREQUAL "PASS")
  message(FATAL_ERROR "Navigation bounds report failed")
endif()