# Fresh evidence for each run. No existing output or source is removed.
cmake_minimum_required(VERSION 3.24)
foreach(required TEST_EXE TEST_ROOT TEST_LABEL TEST_MODE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
if(NOT EXISTS "${TEST_EXE}")
  message(FATAL_ERROR "Missing test executable: ${TEST_EXE}")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
while(TRUE)
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
  set(run "${TEST_ROOT}/${TEST_LABEL}-${stamp}-${nonce}")
  if(NOT EXISTS "${run}")
    break()
  endif()
endwhile()
file(MAKE_DIRECTORY "${run}")
message(STATUS "Preserved test run: ${run}")
set(arguments)
if(TEST_MODE STREQUAL "directory")
  list(APPEND arguments "${run}/output")
elseif(TEST_MODE STREQUAL "project")
  if(NOT DEFINED CATALOG OR NOT EXISTS "${CATALOG}")
    message(FATAL_ERROR "Missing public synthetic golden catalog fixture")
  endif()
  file(SHA256 "${CATALOG}" before_input)
  set(input "${CATALOG}")
  list(APPEND arguments "${run}/output" "${CATALOG}")
elseif(TEST_MODE STREQUAL "asset")
  if(NOT DEFINED MANIFEST OR NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "Missing explicit material manifest")
  endif()
  file(SHA256 "${MANIFEST}" before_input)
  set(input "${MANIFEST}")
  list(APPEND arguments "${MANIFEST}" "${run}/output")
elseif(NOT TEST_MODE STREQUAL "plain")
  message(FATAL_ERROR "Unknown TEST_MODE: ${TEST_MODE}")
endif()
execute_process(COMMAND "${TEST_EXE}" ${arguments}
  RESULT_VARIABLE status OUTPUT_FILE "${run}/test.stdout.log"
  ERROR_FILE "${run}/test.stderr.log" TIMEOUT 540)
file(WRITE "${run}/test-status.txt" "${status}\n")
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "${TEST_LABEL} failed (${status}); inspect ${run}")
endif()
if(DEFINED input)
  file(SHA256 "${input}" after_input)
  if(NOT after_input STREQUAL before_input)
    message(FATAL_ERROR "Test input changed; inspect ${run}")
  endif()
endif()
message(STATUS "${TEST_LABEL} passed; evidence retained at ${run}")