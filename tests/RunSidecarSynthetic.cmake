foreach(required IN ITEMS EXE OUTPUT_ROOT KIND GROUPS CASES CHECKS)
 if(NOT DEFINED ${required})
  message(FATAL_ERROR "Missing ${required}")
 endif()
endforeach()
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(out "${OUTPUT_ROOT}/${stamp}-${nonce}")
file(MAKE_DIRECTORY "${out}")
if(KIND STREQUAL "Project")
 set(argument "${out}")
 set(report "${out}/project-tests-009.json")
else()
 set(argument "${out}/report.json")
 set(report "${argument}")
endif()
execute_process(COMMAND "${EXE}" "${argument}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
message("${stdout}${stderr}")
if(NOT result EQUAL 0 OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Synthetic sidecar test failed")
endif()
file(READ "${report}" body)
string(JSON status GET "${body}" status)
foreach(key IN ITEMS groups cases checks)
 string(JSON actual GET "${body}" "${key}")
 string(TOUPPER "${key}" expected)
 if(NOT actual EQUAL ${expected})
  message(FATAL_ERROR "Exact ${key} mismatch")
 endif()
endforeach()
if(NOT status STREQUAL "PASS")
 message(FATAL_ERROR "Test status mismatch")
endif()
