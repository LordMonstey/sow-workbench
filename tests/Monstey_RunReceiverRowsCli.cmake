if(NOT DEFINED EXE OR NOT DEFINED POWERSHELL OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "Need executable, PowerShell and output root")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(args -Executable "${EXE}" -OutputDirectory "${run}")
if(DEFINED LEGACY_EXE AND NOT LEGACY_EXE STREQUAL "")
 list(APPEND args -LegacyExecutable "${LEGACY_EXE}")
endif()
execute_process(COMMAND "${POWERSHELL}" -NoProfile -ExecutionPolicy Bypass -File
 "${CMAKE_CURRENT_LIST_DIR}/Monstey_WorldReceiverRowsCliTests.ps1" ${args}
 RESULT_VARIABLE code OUTPUT_FILE "${run}.stdout.log" ERROR_FILE "${run}.stderr.log" TIMEOUT 120)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Receiver row CLI controls failed: ${run}")
endif()
file(READ "${run}/result.json" result)
string(JSON status GET "${result}" status)
string(JSON old GET "${result}" legacy_case_count)
string(JSON hkai GET "${result}" new_rejection_case_count)
string(JSON published GET "${result}" published_rejection_case_count)
string(JSON rows GET "${result}" receiver_row_rejection_case_count)
string(JSON help GET "${result}" receiver_row_help_passed)
if(NOT status STREQUAL "PASS" OR NOT old EQUAL 12 OR NOT hkai EQUAL 13 OR NOT published EQUAL 14 OR NOT rows EQUAL 20 OR NOT help)
 message(FATAL_ERROR "Receiver row CLI acceptance incomplete")
endif()
message(STATUS "Receiver rows CLI39 existing controls and20 new rejects PASS; no positive process capture")
