if(NOT DEFINED Monstey_Exe OR NOT EXISTS "${Monstey_Exe}")
  message(FATAL_ERROR "Missing compiled SoW placement independent test")
endif()
if(NOT DEFINED Monstey_ReportDirectory)
  set(Monstey_ReportDirectory "${CMAKE_CURRENT_BINARY_DIR}/sow-manager-placement-independent-results")
endif()
file(MAKE_DIRECTORY "${Monstey_ReportDirectory}")
execute_process(COMMAND "${Monstey_Exe}" "${Monstey_ReportDirectory}/independent.json"
  RESULT_VARIABLE Monstey_Status OUTPUT_VARIABLE Monstey_Out ERROR_VARIABLE Monstey_Err)
file(WRITE "${Monstey_ReportDirectory}/stdout.log" "${Monstey_Out}")
file(WRITE "${Monstey_ReportDirectory}/stderr.log" "${Monstey_Err}")
if(NOT Monstey_Status EQUAL 0)
  message(FATAL_ERROR "SoW placement independent comparison failed: ${Monstey_Status}\n${Monstey_Out}\n${Monstey_Err}")
endif()
