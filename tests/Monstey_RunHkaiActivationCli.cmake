if(NOT DEFINED EXE OR NOT DEFINED POWERSHELL OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "EXE, POWERSHELL and OUTPUT_ROOT are required")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
if(EXISTS "${run}")
  message(FATAL_ERROR "Fresh HKAI CLI acceptance directory required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
execute_process(COMMAND "${POWERSHELL}" -NoProfile -ExecutionPolicy Bypass -File
  "${CMAKE_CURRENT_LIST_DIR}/Monstey_HkaiActivationCliTests.ps1"
  -Executable "${EXE}" -OutputDirectory "${run}"
  RESULT_VARIABLE code OUTPUT_FILE "${run}.stdout.log" ERROR_FILE "${run}.stderr.log" TIMEOUT 120)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "HKAI CLI pre-process acceptance failed: ${run}")
endif()
file(READ "${run}/result.json" result)
string(JSON status GET "${result}" status)
string(JSON legacy GET "${result}" legacy_case_count)
string(JSON negative GET "${result}" new_rejection_case_count)
if(NOT status STREQUAL "PASS" OR NOT legacy EQUAL 12 OR NOT negative EQUAL 13)
  message(FATAL_ERROR "HKAI CLI report does not establish the selected checks")
endif()
message(STATUS "HKAI CLI arguments/output guards and help PASS; no live identity or positive snapshot claim")