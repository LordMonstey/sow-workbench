file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef NONCE)
set(REPORT "${OUT}/integer-${NONCE}.json")
execute_process(COMMAND "${EXE}" "${OUT}/integer-${NONCE}.json" RESULT_VARIABLE RC OUTPUT_VARIABLE LOG ERROR_VARIABLE ERR)
if(NOT RC EQUAL 0)
 message(FATAL_ERROR "Integer test failed: ${RC} ${LOG} ${ERR}")
endif()
file(READ "${REPORT}" JSON)
string(JSON GROUPS GET "${JSON}" groups)
string(JSON CASES GET "${JSON}" cases)
string(JSON CHECKS GET "${JSON}" checks)
string(JSON PASSED GET "${JSON}" passed)
if(NOT PASSED OR NOT GROUPS EQUAL 11 OR NOT CASES EQUAL 466961 OR NOT CHECKS EQUAL 664356)
 message(FATAL_ERROR "Integer result contract differs")
endif()
message(STATUS "${LOG}")
