if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${OUTPUT_ROOT}/unpacked-owned-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 90)
if(NOT result STREQUAL "0")
 message(FATAL_ERROR "Owned unpacked tests failed:${result}\n${stdout}\n${stderr}")
endif()
if(NOT EXISTS "${report}")
 message(FATAL_ERROR "Fresh report absent")
endif()
file(READ "${report}" json)
string(JSON status GET "${json}" status)
string(JSON groups GET "${json}" groups)
string(JSON cases GET "${json}" cases)
string(JSON checks GET "${json}" checks)
string(JSON original GET "${json}" original_executed)
string(JSON assets GET "${json}" original_assets)
string(JSON wrap GET "${json}" CLI_U16_wrap_claim)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 14 OR NOT cases EQUAL 77 OR NOT checks EQUAL 141 OR original OR assets OR wrap)
 message(FATAL_ERROR "Owned unpacked test status/count/scope mismatch")
endif()
message(STATUS "${stdout}; ${report}")
