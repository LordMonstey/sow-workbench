if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef Monstey_Id)
set(Monstey_Report "${OUT}/callback-independent-${Monstey_Id}.json")
execute_process(COMMAND "${EXE}" "${Monstey_Report}" RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Output ERROR_VARIABLE Monstey_Error TIMEOUT 90)
if(NOT Monstey_Result EQUAL 0)
 message(FATAL_ERROR "${Monstey_Output}${Monstey_Error}")
endif()
file(READ "${Monstey_Report}" Monstey_Json)
foreach(Monstey_Field IN ITEMS status cases checks fault_cases original_instruction_bytes_interpreted native_original_entrypoint_invoked)
 string(JSON Monstey_${Monstey_Field} GET "${Monstey_Json}" "${Monstey_Field}")
endforeach()
if(NOT Monstey_status STREQUAL "PASS" OR NOT Monstey_cases EQUAL 791 OR NOT Monstey_checks EQUAL 11138 OR NOT Monstey_fault_cases EQUAL 505 OR Monstey_original_instruction_bytes_interpreted OR Monstey_native_original_entrypoint_invoked)
 message(FATAL_ERROR "Independent callback report changed")
endif()
message(STATUS "${Monstey_Output}")
