foreach(required EXE WORK_ROOT MODE GADB_EXE NAME_EXE CASE_EXE)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${WORK_ROOT}/${stamp}-${nonce}")
file(MAKE_DIRECTORY "${run}/names")
function(native_run label)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${run}/${label}.stdout.txt" "${output}")
  file(WRITE "${run}/${label}.stderr.txt" "${error}")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${label} failed: ${error}")
  endif()
endfunction()
if(MODE STREQUAL "layout")
  native_run(gadb "${GADB_EXE}" "${run}/gadb")
  native_run(names "${NAME_EXE}" "${run}/names/report.json")
  file(GLOB fixtures LIST_DIRECTORIES FALSE "${run}/gadb/run-*/synthetic.gamedb")
  list(LENGTH fixtures fixture_count)
  if(NOT fixture_count EQUAL 1)
    message(FATAL_ERROR "Expected one newly generated GADB fixture")
  endif()
  list(GET fixtures 0 fixture)
  get_filename_component(fixture_directory "${fixture}" DIRECTORY)
  native_run(layout "${EXE}" "${run}/result" "${fixture}" "${fixture_directory}/schema.json" "${run}/names/names.gamedb")
elseif(MODE STREQUAL "cache")
  native_run(cases "${CASE_EXE}" "${run}/cases")
  native_run(cache "${EXE}" "${run}/result" "${run}/cases")
else()
  message(FATAL_ERROR "Unknown mode")
endif()
if(NOT EXISTS "${run}/result/report.json")
  message(FATAL_ERROR "Native result report missing")
endif()
file(READ "${run}/result/report.json" report)
string(JSON status GET "${report}" status)
if(NOT status STREQUAL "PASS")
  message(FATAL_ERROR "Unexpected report status: ${status}")
endif()
message("Native ${MODE} groups passed: ${run}/result/report.json")