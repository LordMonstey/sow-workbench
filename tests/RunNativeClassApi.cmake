file(MAKE_DIRECTORY "${REPORT_DIRECTORY}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(output "${REPORT_DIRECTORY}/api-${nonce}")
execute_process(COMMAND "${TEST_PROGRAM}" "${output}" "${BASELINE_CATALOG}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 50)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Native class API failed: ${stdout}\n${stderr}")
endif()
file(READ "${output}/report.json" text)
foreach(key pass groups assertions direct_rejections pages old225_exact maximum_page_bytes)
 string(JSON ${key} GET "${text}" ${key})
endforeach()
if(NOT pass OR NOT groups EQUAL 13 OR NOT assertions EQUAL 154 OR NOT direct_rejections EQUAL 29 OR NOT pages EQUAL 16 OR NOT old225_exact OR maximum_page_bytes GREATER 28672)
 message(FATAL_ERROR "API coverage changed: ${text}")
endif()
message(STATUS "${stdout}Report ${output}/report.json")
