file(MAKE_DIRECTORY "${REPORT_DIRECTORY}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${REPORT_DIRECTORY}/synthetic-${nonce}.json")
execute_process(COMMAND "${TEST_PROGRAM}" "${report}" RESULT_VARIABLE exit_code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 35)
if(NOT exit_code EQUAL 0)
  message(FATAL_ERROR "Declaration tests failed: ${exit_code}\n${stdout}\n${stderr}")
endif()
file(READ "${report}" result)
string(JSON passed GET "${result}" pass)
string(JSON groups GET "${result}" groups)
string(JSON assertions GET "${result}" assertions)
if(NOT passed OR NOT groups EQUAL 11 OR NOT assertions EQUAL 112)
  message(FATAL_ERROR "Declaration coverage changed: ${result}")
endif()
message(STATUS "${stdout}Report ${report}")
