if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP RUN "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef SUFFIX)
set(REPORT "${OUTPUT_ROOT}/independent-${RUN}-${SUFFIX}.json")
execute_process(COMMAND "${EXE}" "${REPORT}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR TIMEOUT 80)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "Independent Open failed: ${RESULT} ${OUT} ${ERR}")
endif()
file(READ "${REPORT}" BODY)
string(JSON STATUS GET "${BODY}" status)
if(NOT STATUS STREQUAL "PASS")
 message(FATAL_ERROR "Independent Open report is not PASS")
endif()
message(STATUS "${OUT}")
foreach(FIELD IN ITEMS groups cases independent_assertions checks_including_shared_fixture)
 string(JSON VALUE GET "${BODY}" "${FIELD}")
 if(FIELD STREQUAL "groups")
  set(EXPECTED 24)
 elseif(FIELD STREQUAL "cases")
  set(EXPECTED 291)
 elseif(FIELD STREQUAL "independent_assertions")
  set(EXPECTED 631)
 else()
  set(EXPECTED 18512)
 endif()
 if(NOT VALUE EQUAL EXPECTED)
  message(FATAL_ERROR "Independent Open ${FIELD}: ${VALUE} expected ${EXPECTED}")
 endif()
endforeach()
foreach(FIELD IN ITEMS original_native_entrypoint_invoked original_image_loaded original_instruction_bytes_interpreted)
 string(JSON VALUE GET "${BODY}" "${FIELD}")
 if(VALUE)
  message(FATAL_ERROR "Unexpected original execution/interpretation flag: ${FIELD}")
 endif()
endforeach()
