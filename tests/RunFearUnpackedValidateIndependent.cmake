if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT required")
endif()
if(NOT EXISTS "${EXE}")
 message(FATAL_ERROR "Independent validator executable missing")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${OUTPUT_ROOT}/validator-independent-${nonce}.json")
if(EXISTS "${report}")
 message(FATAL_ERROR "Fresh report collision")
endif()
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 70)
if(NOT result STREQUAL "0")
 message(FATAL_ERROR "Independent validator failed: ${result}\n${stdout}\n${stderr}")
endif()
if(NOT EXISTS "${report}")
 message(FATAL_ERROR "Independent fresh report absent")
endif()
file(READ "${report}" json)
string(JSON status GET "${json}" status)
string(JSON groups GET "${json}" groups)
string(JSON cases GET "${json}" cases)
string(JSON checks GET "${json}" checks)
string(JSON original GET "${json}" original_executed)
string(JSON reuse GET "${json}" owner_reference_reused)
string(JSON interpreter GET "${json}" raw_instruction_interpreter)
string(JSON physical GET "${json}" physical_CRT_x87_qualified)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 8 OR NOT cases EQUAL 220257 OR NOT checks EQUAL 577190 OR original OR reuse OR interpreter OR physical)
 message(FATAL_ERROR "Independent validator coverage/scope mismatch")
endif()
message(STATUS "${stdout}; fresh report ${report}")
