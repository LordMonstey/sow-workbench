if(NOT DEFINED EXE OR NOT DEFINED OUT)
  message(FATAL_ERROR "EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(report "${OUT}/getter-${GROUPS}-${stamp}-${suffix}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Getter failed: ${out}${err}")
endif()
file(READ "${report}" body)
string(JSON status GET "${body}" status)
string(JSON groups GET "${body}" groups)
string(JSON checks GET "${body}" checks)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL GROUPS OR NOT checks EQUAL CHECKS)
  message(FATAL_ERROR "Getter did not cover required groups/checks: ${body}")
endif()
message(STATUS "${out}; report=${report}")
