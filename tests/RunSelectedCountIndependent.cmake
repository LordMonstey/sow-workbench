if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
 message(FATAL_ERROR "EXE is required")
endif()
if(NOT DEFINED OUT)
 set(OUT "${CMAKE_CURRENT_BINARY_DIR}/reports")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(report "${OUT}/selected-independent-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Selected count independent failed: ${result}\n${output}\n${error}")
endif()
file(READ "${report}" text)
string(JSON status GET "${text}" status)
string(JSON groups GET "${text}" groups)
string(JSON cases GET "${text}" cases)
string(JSON checks GET "${text}" checks)
string(JSON ranges GET "${text}" range_cases)
string(JSON dynamics GET "${text}" dynamic_cases)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 6 OR NOT cases EQUAL 395432 OR NOT checks EQUAL 1714366 OR NOT ranges EQUAL 215566 OR NOT dynamics EQUAL 7)
 message(FATAL_ERROR "Independent selected count coverage changed: ${text}")
endif()
message(STATUS "${text}")
