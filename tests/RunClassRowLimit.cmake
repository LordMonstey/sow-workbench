file(MAKE_DIRECTORY "${REPORT_DIRECTORY}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${REPORT_DIRECTORY}/rowlimit-${nonce}.json")
execute_process(COMMAND "${TEST_PROGRAM}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 50)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "${stdout}\n${stderr}")
endif()
file(READ "${report}" text)
string(JSON pass GET "${text}" pass)
string(JSON groups GET "${text}" groups)
string(JSON assertions GET "${text}" assertions)
if(NOT pass OR NOT groups EQUAL 8 OR NOT assertions EQUAL 20)
 message(FATAL_ERROR "Unexpected row-limit coverage: ${text}")
endif()
message(STATUS "${stdout}")
