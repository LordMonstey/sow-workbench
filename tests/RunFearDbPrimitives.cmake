if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%d%H%M%S" UTC)
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${OUTPUT_ROOT}/fear-primitives-${stamp}-${nonce}.json")
if(EXISTS "${report}")
 message(FATAL_ERROR "Fresh report collision")
endif()
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT code EQUAL 0 OR NOT EXISTS "${report}")
 message(FATAL_ERROR "FEAR primitive test failed: ${code}: ${stdout} ${stderr}")
endif()
file(READ "${report}" json)
string(JSON passed GET "${json}" passed)
string(JSON groups GET "${json}" groups)
string(JSON cases GET "${json}" cases)
string(JSON checks GET "${json}" checks)
if(NOT passed OR NOT groups EQUAL 9 OR NOT cases EQUAL 39475 OR NOT checks EQUAL 76385)
 message(FATAL_ERROR "Primitive coverage differs: ${groups}/${cases}/${checks}")
endif()
message(STATUS "${stdout}")
