if(NOT DEFINED TEST_EXE OR NOT EXISTS "${TEST_EXE}")
  message(FATAL_ERROR "TEST_EXE must name the independent scalar executable")
endif()
if(NOT DEFINED OUTPUT_ROOT OR OUTPUT_ROOT STREQUAL "")
  message(FATAL_ERROR "OUTPUT_ROOT is required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(prefix "${OUTPUT_ROOT}/${stamp}-${nonce}")
if(EXISTS "${prefix}.log" OR EXISTS "${prefix}.json")
  message(FATAL_ERROR "Refusing to replace an existing scalar test report")
endif()
execute_process(COMMAND "${TEST_EXE}" RESULT_VARIABLE result
                OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${prefix}.log" "${output}${error}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Independent scalar tests failed (${result}): ${prefix}.log\n${output}${error}")
endif()
if(NOT output MATCHES "PASS independent_scalar groups=13 cases=28921 checks=46452")
  message(FATAL_ERROR "Independent scalar coverage changed: ${prefix}.log\n${output}${error}")
endif()
file(SHA256 "${TEST_EXE}" executable_hash)
file(WRITE "${prefix}.json"
  "{\n  \"format\": \"Monstey.IndependentScalarTests/1\",\n  \"status\": \"PASS\",\n  \"groups\": 13,\n  \"cases\": 28921,\n  \"checks\": 46452,\n  \"executable_sha256\": \"${executable_hash}\",\n  \"synthetic_only\": true\n}\n")
message(STATUS "PASS independent scalar 13 groups / 28921 cases / 46452 checks: ${prefix}.json")