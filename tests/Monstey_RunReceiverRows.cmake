if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "Need executable and output root")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
file(MAKE_DIRECTORY "${run}")
set(arguments "${run}/report.json")
set(native_proof_supplied FALSE)
set(expected_count 28)
if(DEFINED NATIVE_PROOF AND NOT NATIVE_PROOF STREQUAL "")
  list(APPEND arguments "${NATIVE_PROOF}")
  set(native_proof_supplied TRUE)
  set(expected_count 29)
endif()
execute_process(COMMAND "${TEST_EXE}" ${arguments}
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
message("${output}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Receiver rows failed: ${error}")
endif()
if(NOT EXISTS "${run}/report.json")
  message(FATAL_ERROR "Receiver rows report missing")
endif()
file(READ "${run}/report.json" result)
string(JSON passed GET "${result}" status)
string(JSON count GET "${result}" count)
string(JSON source_profile_qualified GET "${result}" source_profile_qualified)
if(NOT passed STREQUAL "PASS" OR NOT count EQUAL expected_count)
  message(FATAL_ERROR "Receiver rows acceptance incomplete")
endif()
if(native_proof_supplied AND NOT source_profile_qualified)
  message(FATAL_ERROR "Receiver rows supplied proof was not qualified")
elseif(NOT native_proof_supplied AND source_profile_qualified)
  message(FATAL_ERROR "Receiver rows reports native qualification without a proof")
endif()
