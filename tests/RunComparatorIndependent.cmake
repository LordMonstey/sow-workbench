if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(report "${OUTPUT_ROOT}/comparator-${stamp}-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("${out}${err}")
if(NOT result EQUAL 0 OR NOT EXISTS "${report}")
 message(FATAL_ERROR "Comparator independent failure")
endif()
file(READ "${report}" body)
string(JSON status GET "${body}" status)
string(JSON bound GET "${body}" product_bound)
string(JSON cases GET "${body}" cases)
string(JSON checks GET "${body}" checks)
if(NOT status STREQUAL "PASS" OR NOT bound OR NOT cases EQUAL 1086 OR NOT checks EQUAL 7413)
 message(FATAL_ERROR "Exact independent comparator coverage mismatch")
endif()
