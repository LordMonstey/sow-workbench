if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "Required: EXE and OUT")
endif()
if(NOT EXISTS "${EXE}")
 message(FATAL_ERROR "Owned test executable not found: ${EXE}")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(request_nonce "${nonce}")
set(report "${OUT}/encoded-string-${nonce}.json")
if(EXISTS "${report}")
 message(FATAL_ERROR "Fresh report path collision")
endif()
execute_process(COMMAND "${EXE}" "${report}" "${nonce}" RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
if(NOT code STREQUAL "0" OR NOT EXISTS "${report}")
 message(FATAL_ERROR "SoW encoded string test failed (${code}): ${stdout}${stderr}")
endif()
file(READ "${report}" data)
foreach(key status nonce groups cases checks faults original_code_executed synthetic_only)
 string(JSON ${key} ERROR_VARIABLE error GET "${data}" "${key}")
 if(NOT error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "Invalid fresh report ${key}: ${error}")
 endif()
endforeach()
if(NOT status STREQUAL "PASS" OR NOT nonce STREQUAL "${request_nonce}")
 message(FATAL_ERROR "Unexpected report identity/status")
endif()
# The requested nonce is retained separately because JSON extraction must not
# overwrite it before checking an independently produced report.
string(REGEX MATCH "encoded-string-([0-9a-f]+)\\.json$" file_match "${report}")
if(NOT nonce STREQUAL "${CMAKE_MATCH_1}")
 message(FATAL_ERROR "Report nonce does not match its unique request path")
endif()
if(NOT groups EQUAL 6 OR NOT cases EQUAL 652 OR NOT checks EQUAL 92373 OR NOT faults EQUAL 7)
 message(FATAL_ERROR "Expected synthetic coverage was not executed: ${data}")
endif()
if(original_code_executed OR NOT synthetic_only)
 message(FATAL_ERROR "Unexpected original-code/data scope")
endif()
message(STATUS "${stdout}Fresh report: ${report}")
