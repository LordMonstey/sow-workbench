if(NOT DEFINED EXE OR NOT DEFINED CATALOG OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE, CATALOG and OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef Monstey_Nonce)
set(Monstey_Run "${OUTPUT_ROOT}/${Monstey_Nonce}")
execute_process(COMMAND "${EXE}" "${Monstey_Run}" "${CATALOG}" RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Out ERROR_VARIABLE Monstey_Err TIMEOUT 45)
if(NOT Monstey_Result STREQUAL "0")
 message(FATAL_ERROR "SoW Runtime test failed:${Monstey_Result}\n${Monstey_Out}\n${Monstey_Err}")
endif()
file(READ "${Monstey_Run}/report.json" Monstey_Report)
string(JSON Monstey_Status GET "${Monstey_Report}" status)
string(JSON Monstey_Count GET "${Monstey_Report}" catalog)
string(JSON Monstey_Old GET "${Monstey_Report}" inherited_descriptors_unchanged)
if(NOT Monstey_Status STREQUAL "PASS" OR NOT Monstey_Count EQUAL 227 OR NOT Monstey_Old EQUAL 226)
 message(FATAL_ERROR "SoW Runtime report differs")
endif()
message(STATUS "${Monstey_Out}; ${Monstey_Run}/report.json")
