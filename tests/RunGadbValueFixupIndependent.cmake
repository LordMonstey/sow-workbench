if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
 message(FATAL_ERROR "EXE must name the owned independent test")
endif()
if(NOT DEFINED OUT)
 set(OUT "${CMAKE_CURRENT_BINARY_DIR}/fixup-independent-reports")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef Monstey_nonce)
set(Monstey_report "${OUT}/independent-${Monstey_nonce}.json")
execute_process(COMMAND "${EXE}" "${Monstey_report}" RESULT_VARIABLE Monstey_result OUTPUT_VARIABLE Monstey_stdout ERROR_VARIABLE Monstey_stderr TIMEOUT 90)
if(NOT Monstey_result EQUAL 0 OR NOT EXISTS "${Monstey_report}")
 message(FATAL_ERROR "Independent fixup test failed: ${Monstey_result}\n${Monstey_stdout}\n${Monstey_stderr}")
endif()
file(READ "${Monstey_report}" Monstey_text)
foreach(Monstey_field status groups cases checks fault_cases)
 string(JSON ${Monstey_field} GET "${Monstey_text}" ${Monstey_field})
endforeach()
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 8 OR NOT cases EQUAL 37804 OR NOT checks EQUAL 108288 OR NOT fault_cases EQUAL 16514)
 message(FATAL_ERROR "Independent coverage mismatch: ${Monstey_text}")
endif()
message(STATUS "${Monstey_text}")
