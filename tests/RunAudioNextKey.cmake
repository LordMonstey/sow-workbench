if(NOT DEFINED EXE OR NOT EXISTS "${EXE}")
  message(FATAL_ERROR "EXE must name the built AudioNextKey test")
endif()
if(NOT DEFINED REPORT_DIR)
  set(REPORT_DIR "${CMAKE_CURRENT_BINARY_DIR}")
endif()
file(MAKE_DIRECTORY "${REPORT_DIR}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(report "${REPORT_DIR}/audio-nextkey-${nonce}.json")
execute_process(COMMAND "${EXE}" "${report}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${report}")
  message(FATAL_ERROR "AudioNextKey test failed: ${result}\n${output}\n${error}")
endif()
file(READ "${report}" text)
string(JSON status GET "${text}" status)
string(JSON groups GET "${text}" groups)
string(JSON cases GET "${text}" cases)
string(JSON checks GET "${text}" checks)
string(JSON ranges GET "${text}" consumed_range_cases)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 8 OR NOT cases EQUAL 226236 OR NOT checks EQUAL 1287484 OR NOT ranges EQUAL 94548)
  message(FATAL_ERROR "AudioNextKey coverage counters differ: ${text}")
endif()
message(STATUS "AudioNextKey full owned-memory profile: ${text}")
