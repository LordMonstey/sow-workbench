foreach(name IN ITEMS TEST_EXE OUTPUT_ROOT GROUPS CASES CHECKS)
  if(NOT DEFINED ${name})
    message(FATAL_ERROR "Missing ${name}")
  endif()
endforeach()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(REPORT "${OUTPUT_ROOT}/${stamp}-${nonce}.json")
get_filename_component(outdir "${REPORT}" DIRECTORY)
file(MAKE_DIRECTORY "${outdir}")
if(EXISTS "${REPORT}")
  message(FATAL_ERROR "Refusing to replace existing report ${REPORT}")
endif()
execute_process(COMMAND "${TEST_EXE}" "${REPORT}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "${code}: ${out} ${err}")
endif()
file(READ "${REPORT}" json)
string(JSON status GET "${json}" status)
string(JSON actual_groups GET "${json}" groups)
string(JSON actual_cases GET "${json}" cases)
string(JSON actual_checks GET "${json}" checks)
if(NOT status STREQUAL "PASS" OR NOT actual_groups EQUAL GROUPS OR NOT actual_cases EQUAL CASES OR NOT actual_checks EQUAL CHECKS)
  message(FATAL_ERROR "Exact independent coverage differs: ${actual_groups}/${actual_cases}/${actual_checks}")
endif()
message(STATUS "PASS ${GROUPS}groups/${CASES}cases/${CHECKS}checks")
