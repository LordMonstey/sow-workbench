if(NOT DEFINED EXE OR NOT DEFINED OUT)
 message(FATAL_ERROR "EXE and OUT required")
endif()
file(MAKE_DIRECTORY "${OUT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef Monstey_Id)
set(Monstey_Report "${OUT}/lta-independent-${Monstey_Id}.json")
execute_process(COMMAND "${EXE}" "${Monstey_Report}" RESULT_VARIABLE Monstey_Exit OUTPUT_VARIABLE Monstey_Output ERROR_VARIABLE Monstey_Error TIMEOUT 90)
if(NOT Monstey_Exit EQUAL 0)
 message(FATAL_ERROR "${Monstey_Output}${Monstey_Error}")
endif()
file(READ "${Monstey_Report}" Monstey_Json)
foreach(Monstey_Key IN ITEMS status cases checks budget_cases actual_input_bytes original_instruction_bytes_interpreted native_original_entrypoint_invoked)
 string(JSON Monstey_${Monstey_Key} GET "${Monstey_Json}" "${Monstey_Key}")
endforeach()
if(NOT Monstey_status STREQUAL "PASS" OR NOT Monstey_cases EQUAL 18347 OR NOT Monstey_checks EQUAL 107682 OR NOT Monstey_budget_cases EQUAL 800 OR NOT Monstey_actual_input_bytes EQUAL 0 OR Monstey_original_instruction_bytes_interpreted OR Monstey_native_original_entrypoint_invoked)
 message(FATAL_ERROR "LTA independent result changed")
endif()
message(STATUS "${Monstey_Output}")
