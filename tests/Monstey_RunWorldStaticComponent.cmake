if(NOT DEFINED EXE OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "EXE and WORK_ROOT are required")
endif()
file(MAKE_DIRECTORY "${WORK_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(out "${WORK_ROOT}/run-${stamp}-${nonce}")
set(args "${out}")
if(DEFINED ACTUAL_MESH OR DEFINED ACTUAL_RENDER)
  if(NOT DEFINED ACTUAL_MESH OR NOT DEFINED ACTUAL_RENDER)
    message(FATAL_ERROR "Both private actual pair paths are required")
  endif()
  list(APPEND args "${ACTUAL_MESH}" "${ACTUAL_RENDER}")
endif()
execute_process(COMMAND "${EXE}" ${args} RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${out}.console.log" "${output}${error}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native static component test failed: ${result}; ${out}.console.log")
endif()
message(STATUS "${output}")
