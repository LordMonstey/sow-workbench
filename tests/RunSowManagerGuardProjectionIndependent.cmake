# Exact compiled differential observer and reference are rebuilt in the cohort.
# This runner records the actual cohort artifacts; standalone LIB hashes are
# historical qualification metadata and are never cohort link inputs.
foreach(Monstey_Required IN ITEMS Monstey_Exe Monstey_Data Monstey_Core Monstey_Out Monstey_SourceRoot Monstey_BuildRoot Monstey_Config)
  if(NOT DEFINED ${Monstey_Required} OR "${${Monstey_Required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${Monstey_Required}")
  endif()
endforeach()
if(EXISTS "${Monstey_Out}/actual-differential.json")
  message(FATAL_ERROR "Guard projection report already exists; retained without replay")
endif()
file(MAKE_DIRECTORY "${Monstey_Out}")
execute_process(COMMAND "${Monstey_Exe}" "${Monstey_Out}/actual-differential.json"
  RESULT_VARIABLE Monstey_Code OUTPUT_FILE "${Monstey_Out}/stdout.txt"
  ERROR_FILE "${Monstey_Out}/stderr.txt" TIMEOUT 60)
if(NOT Monstey_Code EQUAL 0)
  message(FATAL_ERROR "Actual guard projection differential failed (${Monstey_Code}); retained ${Monstey_Out}")
endif()
file(READ "${Monstey_Out}/actual-differential.json" Monstey_Report)
string(JSON Monstey_Status GET "${Monstey_Report}" status)
if(NOT Monstey_Status STREQUAL "PASS")
  message(FATAL_ERROR "Guard projection differential report is not PASS")
endif()
foreach(Monstey_Entry IN ITEMS paired_cases=70 cases_started=70 assertions=2399 differential_checks=705 whole_image_bytes_compared=16256 product_calls=73 reference_calls=73 product_import_events=54 reference_import_events=54 GP01_cases=10 GP02_cases=26 GP03_cases=4 GP04_cases=30)
  string(REPLACE "=" ";" Monstey_Parts "${Monstey_Entry}")
  list(GET Monstey_Parts 0 Monstey_Key)
  list(GET Monstey_Parts 1 Monstey_Expected)
  string(JSON Monstey_Actual GET "${Monstey_Report}" "${Monstey_Key}")
  if(NOT "${Monstey_Actual}" STREQUAL "${Monstey_Expected}")
    message(FATAL_ERROR "Guard projection ${Monstey_Key}: ${Monstey_Actual}, expected ${Monstey_Expected}")
  endif()
endforeach()
string(JSON Monstey_Failures LENGTH "${Monstey_Report}" failures)
if(NOT Monstey_Failures EQUAL 0)
  message(FATAL_ERROR "Guard projection report contains failures")
endif()
function(Monstey_Quote Monstey_Output Monstey_Value)
  string(REPLACE "\\" "\\\\" Monstey_Value "${Monstey_Value}")
  string(REPLACE "\"" "\\\"" Monstey_Value "${Monstey_Value}")
  string(REPLACE "\r" "\\r" Monstey_Value "${Monstey_Value}")
  string(REPLACE "\n" "\\n" Monstey_Value "${Monstey_Value}")
  set(${Monstey_Output} "\"${Monstey_Value}\"" PARENT_SCOPE)
endfunction()
set(Monstey_Target "Monstey_SowManagerGuardProjectionIndependent")
file(GLOB_RECURSE Monstey_Objects LIST_DIRECTORIES false "${Monstey_BuildRoot}/${Monstey_Target}.dir/${Monstey_Config}/*.obj")
list(LENGTH Monstey_Objects Monstey_ObjectCount)
if(NOT Monstey_ObjectCount EQUAL 2)
  message(FATAL_ERROR "Expected two freshly compiled observer/reference objects, got ${Monstey_ObjectCount}")
endif()
file(GLOB_RECURSE Monstey_Tlogs LIST_DIRECTORIES false "${Monstey_BuildRoot}/${Monstey_Target}.dir/${Monstey_Config}/*.tlog")
set(Monstey_LinkTlogFound FALSE)
foreach(Monstey_Tlog IN LISTS Monstey_Tlogs)
  get_filename_component(Monstey_TlogName "${Monstey_Tlog}" NAME)
  if(Monstey_TlogName STREQUAL "link.command.1.tlog")
    set(Monstey_LinkTlogFound TRUE)
  endif()
endforeach()
if(NOT Monstey_LinkTlogFound)
  message(FATAL_ERROR "Actual cohort link command tlog is missing")
endif()
set(Monstey_Map "${Monstey_BuildRoot}/guard-projection-independent-${Monstey_Config}.map")
set(Monstey_DataGuardObject "${Monstey_BuildRoot}/Monstey_Data.dir/${Monstey_Config}/Monstey_GadbManagerGuardProjection.obj")
set(Monstey_DataM1Object "${Monstey_BuildRoot}/Monstey_Data.dir/${Monstey_Config}/Monstey_GadbManagerPrimitives.obj")
set(Monstey_Files "${Monstey_Exe}" "${Monstey_Data}" "${Monstey_Core}" "${Monstey_Map}" "${Monstey_DataGuardObject}" "${Monstey_DataM1Object}"
  "${Monstey_SourceRoot}/include/Monstey_GadbManagerGuardProjection.hpp"
  "${Monstey_SourceRoot}/include/Monstey_GadbManagerPrimitives.hpp"
  "${Monstey_SourceRoot}/include/Monstey_FearDbCallable.hpp"
  "${Monstey_SourceRoot}/tests/Monstey_GuardProjectionReference.cpp"
  "${Monstey_SourceRoot}/tests/Monstey_GuardProjectionReference.hpp"
  "${Monstey_SourceRoot}/tests/Monstey_GuardProjectionDifferential.cpp")
list(APPEND Monstey_Files ${Monstey_Objects} ${Monstey_Tlogs})
list(REMOVE_DUPLICATES Monstey_Files)
set(Monstey_Pins "")
foreach(Monstey_File IN LISTS Monstey_Files)
  if(NOT EXISTS "${Monstey_File}")
    message(FATAL_ERROR "Actual cohort provenance input missing: ${Monstey_File}")
  endif()
  file(SIZE "${Monstey_File}" Monstey_Size)
  file(SHA256 "${Monstey_File}" Monstey_Sha)
  Monstey_Quote(Monstey_PathJson "${Monstey_File}")
  if(NOT Monstey_Pins STREQUAL "")
    string(APPEND Monstey_Pins ",")
  endif()
  string(APPEND Monstey_Pins "{\"path\":${Monstey_PathJson},\"bytes\":${Monstey_Size},\"sha256\":\"${Monstey_Sha}\"}")
endforeach()
file(WRITE "${Monstey_Out}/cohort-bindings.json"
  "{\"schema\":\"Monstey.GuardProjectionCohortBindings/1\",\"status\":\"PASS_ACTUAL_FRESH_DATA_CORE_EXE_AND_OBJECT_INPUTS\",\"standalone_origin\":\"Independent receipt010 is historical; this cohort recompiles both CPPs and uses its actual Data/Core\",\"physical_or_parent_qualification\":false,\"pins\":[${Monstey_Pins}]}\n")
message(STATUS "Actual guard projection independent comparison: 70 pairs, 705 differential checks, 16256 image bytes")
