if(NOT TEST_EXE OR NOT OUTPUT_ROOT)
  message(FATAL_ERROR "TEST_EXE and OUTPUT_ROOT are required")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
execute_process(COMMAND "${TEST_EXE}" "${run}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native texture test failed: ${result}; evidence retained at ${run}")
endif()
