if(NOT DEFINED EXE)
 message(FATAL_ERROR "EXE required")
endif()
execute_process(COMMAND "${EXE}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
 message(FATAL_ERROR "Independent CRT failure: ${status} ${error}")
endif()
string(JSON state GET "${output}" status)
string(JSON cases GET "${output}" cases)
string(JSON checks GET "${output}" checks)
if(NOT state STREQUAL "PASS" OR NOT cases EQUAL 360448 OR NOT checks EQUAL 606208)
 message(FATAL_ERROR "Unexpected independent CRT result: ${output}")
endif()
message(STATUS "${output}")
