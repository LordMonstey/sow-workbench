foreach(Monstey_Required EXE OUTPUT_ROOT EXPECTED_GROUPS EXPECTED_CASES EXPECTED_CHECKS)
 if(NOT DEFINED ${Monstey_Required})
  message(FATAL_ERROR "Explicit independent test argument required: ${Monstey_Required}")
 endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP Monstey_Stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef Monstey_Nonce)
set(Monstey_Report "${OUTPUT_ROOT}/report-${Monstey_Stamp}-${Monstey_Nonce}.json")
execute_process(COMMAND "${EXE}" "${Monstey_Report}" RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Out ERROR_VARIABLE Monstey_Err)
if(NOT Monstey_Result EQUAL 0)
 message(FATAL_ERROR "Independent test failed: ${Monstey_Out}${Monstey_Err}")
endif()
file(READ "${Monstey_Report}" Monstey_Json)
string(JSON Monstey_Status GET "${Monstey_Json}" status)
if(NOT Monstey_Status STREQUAL "PASS")
 message(FATAL_ERROR "Independent report did not pass")
endif()
foreach(Monstey_Key IN ITEMS groups cases checks)
 string(TOUPPER "${Monstey_Key}" Monstey_Upper)
 string(JSON Monstey_Value GET "${Monstey_Json}" "${Monstey_Key}")
 if(NOT Monstey_Value EQUAL EXPECTED_${Monstey_Upper})
  message(FATAL_ERROR "Independent ${Monstey_Key} coverage changed")
 endif()
endforeach()
if(DEFINED EXPECTED_FAULTS)
 string(JSON Monstey_Faults GET "${Monstey_Json}" fault_cases)
 if(NOT Monstey_Faults EQUAL EXPECTED_FAULTS)
  message(FATAL_ERROR "Independent consumed-fault coverage changed")
 endif()
endif()
message(STATUS "${Monstey_Out}")