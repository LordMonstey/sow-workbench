file(MAKE_DIRECTORY "${REPORT_DIRECTORY}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(report "${REPORT_DIRECTORY}/independent-${nonce}.json")
execute_process(COMMAND "${TEST_PROGRAM}" "${report}" RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 35)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Independent class tests failed: ${stdout}\n${stderr}")
endif()
file(READ "${report}" result)
string(JSON status GET "${result}" status)
string(JSON groups GET "${result}" groups)
string(JSON cases GET "${result}" cases)
string(JSON assertions GET "${result}" assertions)
string(JSON fields GET "${result}" raw_field_rows_checked)
if(NOT status STREQUAL PASS OR NOT groups EQUAL 7 OR NOT cases EQUAL 1178 OR NOT assertions EQUAL 90027 OR NOT fields EQUAL 5672)
  message(FATAL_ERROR "Independent coverage differs: ${result}")
endif()
message(STATUS "${stdout}Result ${report}")
