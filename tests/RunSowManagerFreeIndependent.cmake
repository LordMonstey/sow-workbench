if(NOT DEFINED Monstey_Exe OR NOT DEFINED Monstey_Out OR
   NOT DEFINED Monstey_Data OR NOT DEFINED Monstey_Core OR
   NOT DEFINED Monstey_Build OR NOT DEFINED Monstey_ObjectRoot OR
   NOT DEFINED Monstey_DataObjectRoot OR NOT DEFINED Monstey_FreeCPP OR
   NOT DEFINED Monstey_FreeHPP)
  message(FATAL_ERROR "Current target paths, build/object roots and FreeCPP/HPP provenance are required")
endif()
file(MAKE_DIRECTORY "${Monstey_Out}")
execute_process(COMMAND "${Monstey_Exe}" "${Monstey_Out}/actual-differential.json"
  RESULT_VARIABLE Monstey_Result OUTPUT_VARIABLE Monstey_Stdout
  ERROR_VARIABLE Monstey_Stderr)
file(WRITE "${Monstey_Out}/stdout.txt" "${Monstey_Stdout}")
file(WRITE "${Monstey_Out}/stderr.txt" "${Monstey_Stderr}")
if(NOT Monstey_Result EQUAL 0)
  message(FATAL_ERROR "Actual Free independent comparison failed: ${Monstey_Result}\n${Monstey_Stdout}\n${Monstey_Stderr}")
endif()
file(READ "${Monstey_Out}/actual-differential.json" Monstey_Json)
file(READ "${Monstey_Out}/actual-differential.json.differential.json" Monstey_Diff)
string(JSON Monstey_Status GET "${Monstey_Json}" status)
string(JSON Monstey_Cases GET "${Monstey_Json}" cases)
string(JSON Monstey_Checks GET "${Monstey_Json}" checks)
string(JSON Monstey_Classes GET "${Monstey_Json}" normal_exit_classes)
string(JSON Monstey_DiffStatus GET "${Monstey_Diff}" status)
string(JSON Monstey_Calls GET "${Monstey_Diff}" actual_calls)
string(JSON Monstey_Symbols GET "${Monstey_Diff}" symbols)
string(JSON Monstey_Compared GET "${Monstey_Diff}" comparisons)
string(JSON Monstey_Bytes GET "${Monstey_Diff}" whole_image_bytes)
string(JSON Monstey_Faults GET "${Monstey_Diff}" fault_comparisons)
string(JSON Monstey_Origin GET "${Monstey_Diff}" actual_library)
if(NOT Monstey_Status STREQUAL "PASS" OR NOT Monstey_DiffStatus STREQUAL "PASS"
   OR NOT Monstey_Cases EQUAL 151 OR NOT Monstey_Checks EQUAL 281
   OR NOT Monstey_Classes EQUAL 126 OR NOT Monstey_Calls EQUAL 153
   OR NOT Monstey_Symbols EQUAL 23 OR NOT Monstey_Compared EQUAL 768
   OR NOT Monstey_Bytes EQUAL 39322188 OR NOT Monstey_Faults EQUAL 10
   OR NOT Monstey_Origin STREQUAL "bf16aa1ce3c919b4bd3ce6d94580412363e626761c4be8c7a2e6661562334238")
  message(FATAL_ERROR "Free independent report does not match the frozen qualification fixture contract")
endif()
# Raw observer output is preserved. Its legacy actual_library field means
# standalone qualification origin ONLY. The composite below never calls it the
# current library hash and records actual current Data/Core/link/object pins.
file(SHA256 "${Monstey_Data}" Monstey_DataSha)
file(SHA256 "${Monstey_Core}" Monstey_CoreSha)
file(SHA256 "${Monstey_Exe}" Monstey_ExeSha)
if(Monstey_DataSha STREQUAL Monstey_Origin OR Monstey_CoreSha STREQUAL Monstey_Origin)
  message(FATAL_ERROR "Standalone product origin must not be substituted for current cohort Data/Core")
endif()
file(TO_CMAKE_PATH "${Monstey_Data}" Monstey_DataPath)
file(TO_CMAKE_PATH "${Monstey_Core}" Monstey_CorePath)
file(TO_CMAKE_PATH "${Monstey_Exe}" Monstey_ExePath)
file(TO_CMAKE_PATH "${Monstey_Build}" Monstey_BuildPath)
file(RELATIVE_PATH Monstey_DataRelative "${Monstey_BuildPath}" "${Monstey_DataPath}")
file(RELATIVE_PATH Monstey_CoreRelative "${Monstey_BuildPath}" "${Monstey_CorePath}")
file(GLOB_RECURSE Monstey_LinkLogs LIST_DIRECTORIES FALSE "${Monstey_ObjectRoot}/link.command.1.tlog")
list(LENGTH Monstey_LinkLogs Monstey_LinkCount)
if(NOT Monstey_LinkCount EQUAL 1)
  message(FATAL_ERROR "Exactly one current MSVC link command tlog is required")
endif()
list(GET Monstey_LinkLogs 0 Monstey_LinkLog)
file(STRINGS "${Monstey_LinkLog}" Monstey_LinkLines ENCODING UTF-16LE)
list(JOIN Monstey_LinkLines "\n" Monstey_LinkText)
string(REPLACE "\\" "/" Monstey_LinkText "${Monstey_LinkText}")
string(TOLOWER "${Monstey_LinkText}" Monstey_LinkLower)
foreach(Monstey_Library IN ITEMS Data Core)
  string(TOLOWER "${Monstey_${Monstey_Library}Path}" Monstey_FullLower)
  string(TOLOWER "${Monstey_${Monstey_Library}Relative}" Monstey_RelativeLower)
  string(FIND "${Monstey_LinkLower}" "${Monstey_FullLower}" Monstey_FullFound)
  string(FIND "${Monstey_LinkLower}" "${Monstey_RelativeLower}" Monstey_RelativeFound)
  if(Monstey_FullFound LESS 0 AND Monstey_RelativeFound LESS 0)
    message(FATAL_ERROR "Current ${Monstey_Library} path absent from actual link command")
  endif()
endforeach()
foreach(Monstey_Forbidden IN ITEMS "monstey_gadbmanagerfree.lib" "monstey_freereference.lib" "monstey_backendreference.lib")
  string(FIND "${Monstey_LinkLower}" "${Monstey_Forbidden}" Monstey_FallbackFound)
  if(NOT Monstey_FallbackFound LESS 0)
    message(FATAL_ERROR "Standalone product/reference archive fallback in current cohort link")
  endif()
endforeach()
file(GLOB Monstey_Objects LIST_DIRECTORIES FALSE "${Monstey_ObjectRoot}/*.obj")
set(Monstey_ExpectedObjects Monstey_FreeActualIndependent Monstey_FreeReference Monstey_BackendReference Monstey_PlacementReference)
list(LENGTH Monstey_Objects Monstey_ObjectCount)
if(NOT Monstey_ObjectCount EQUAL 4)
  message(FATAL_ERROR "Expected exactly four freshly built observer/oracle objects")
endif()
set(Monstey_ObjectPins "[]")
foreach(Monstey_Object IN LISTS Monstey_Objects)
  get_filename_component(Monstey_ObjectName "${Monstey_Object}" NAME_WE)
  if(NOT Monstey_ObjectName IN_LIST Monstey_ExpectedObjects)
    message(FATAL_ERROR "Unexpected observer/oracle object: ${Monstey_ObjectName}")
  endif()
  list(REMOVE_ITEM Monstey_ExpectedObjects "${Monstey_ObjectName}")
  file(SHA256 "${Monstey_Object}" Monstey_ObjectSha)
  file(TO_CMAKE_PATH "${Monstey_Object}" Monstey_ObjectPath)
  set(Monstey_ObjectPin "{}")
  string(JSON Monstey_ObjectPin SET "${Monstey_ObjectPin}" path "\"${Monstey_ObjectPath}\"")
  string(JSON Monstey_ObjectPin SET "${Monstey_ObjectPin}" sha256 "\"${Monstey_ObjectSha}\"")
  string(JSON Monstey_Index LENGTH "${Monstey_ObjectPins}")
  string(JSON Monstey_ObjectPins SET "${Monstey_ObjectPins}" ${Monstey_Index} "${Monstey_ObjectPin}")
endforeach()
if(Monstey_ExpectedObjects)
  message(FATAL_ERROR "Missing current reference object(s): ${Monstey_ExpectedObjects}")
endif()
set(Monstey_FreeObject "${Monstey_DataObjectRoot}/Monstey_GadbManagerFree.obj")
file(SHA256 "${Monstey_FreeObject}" Monstey_FreeObjectSha)
file(SHA256 "${Monstey_FreeCPP}" Monstey_FreeCPPsha)
file(SHA256 "${Monstey_FreeHPP}" Monstey_FreeHPPsha)
file(SHA256 "${Monstey_LinkLog}" Monstey_LinkSha)
file(SHA256 "${Monstey_Out}/actual-differential.json.differential.json" Monstey_ReportSha)
file(TO_CMAKE_PATH "${Monstey_LinkLog}" Monstey_LinkPath)
file(TO_CMAKE_PATH "${Monstey_FreeObject}" Monstey_FreeObjectPath)
file(TO_CMAKE_PATH "${Monstey_FreeCPP}" Monstey_FreeCPPpath)
file(TO_CMAKE_PATH "${Monstey_FreeHPP}" Monstey_FreeHPPpath)
file(TO_CMAKE_PATH "${Monstey_Out}/actual-differential.json.differential.json" Monstey_ReportPath)
set(Monstey_Binding "{}")
string(JSON Monstey_Binding SET "${Monstey_Binding}" status "\"PASS\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" scope "\"CURRENT_COHORT_DATA_CORE_ACTUAL_FREE_DIFFERENTIAL\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" standalone_product_origin_sha256 "\"${Monstey_Origin}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" raw_observer_actual_library_field_scope "\"standalone_product_origin_sha256 only; never current cohort Data/Core identity\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" raw_observer_report_path "\"${Monstey_ReportPath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" raw_observer_report_sha256 "\"${Monstey_ReportSha}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_data_path "\"${Monstey_DataPath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_data_sha256 "\"${Monstey_DataSha}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_core_path "\"${Monstey_CorePath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_core_sha256 "\"${Monstey_CoreSha}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_observer_exe_path "\"${Monstey_ExePath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_observer_exe_sha256 "\"${Monstey_ExeSha}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" link_working_directory "\"${Monstey_BuildPath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" actual_link_command_path "\"${Monstey_LinkPath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" actual_link_command_sha256 "\"${Monstey_LinkSha}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" observer_reference_objects "${Monstey_ObjectPins}")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_free_product_object_path "\"${Monstey_FreeObjectPath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_free_product_object_sha256 "\"${Monstey_FreeObjectSha}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_free_product_CPP_path "\"${Monstey_FreeCPPpath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_free_product_CPP_sha256 "\"${Monstey_FreeCPPsha}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_free_product_HPP_path "\"${Monstey_FreeHPPpath}\"")
string(JSON Monstey_Binding SET "${Monstey_Binding}" current_free_product_HPP_sha256 "\"${Monstey_FreeHPPsha}\"")
file(WRITE "${Monstey_Out}/cohort-binding.json" "${Monstey_Binding}\n")
message(STATUS "Actual Free independent comparison:151 cases,126 classes,153 calls,23 entries; current Data=${Monstey_DataSha}; standalone origin=${Monstey_Origin}")
