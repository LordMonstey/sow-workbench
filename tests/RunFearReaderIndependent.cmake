if(NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE and OUTPUT_ROOT are required")
endif()
string(TIMESTAMP stamp "%Y%m%d%H%M%S" UTC)
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(report "${OUTPUT_ROOT}/fear-reader-independent-${stamp}-${nonce}.log")
if(EXISTS "${report}")
 message(FATAL_ERROR "New report required")
endif()
execute_process(COMMAND "${EXE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
file(WRITE "${report}" "${output}${error}")
string(STRIP "${output}" output)
if(NOT result EQUAL 0 OR NOT output STREQUAL "PASS fear_reader_independent groups=8 cases=99826 checks=199652")
 message(FATAL_ERROR "Independent FEAR reader regression failed: ${result}: ${output}${error}")
endif()
message(STATUS "${output}")