if(NOT DEFINED EXE OR NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "EXE,TEST_EXE,OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
file(GLOB before "${OUTPUT_ROOT}/run-*/receipt.json")
set(shell "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe")
execute_process(COMMAND "${shell}" -NoProfile -ExecutionPolicy Bypass -File "${CMAKE_CURRENT_LIST_DIR}/RunFearUnpackedInspectorCli.ps1" -Exe "${EXE}" -TestExe "${TEST_EXE}" -OutputRoot "${OUTPUT_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 140)
if(NOT result STREQUAL "0")
 message(FATAL_ERROR "Owned CLI tests failed:${result}\n${stdout}\n${stderr}")
endif()
file(GLOB after "${OUTPUT_ROOT}/run-*/receipt.json")
foreach(old IN LISTS before)
 list(REMOVE_ITEM after "${old}")
endforeach()
list(LENGTH after count)
if(NOT count EQUAL 1)
 message(FATAL_ERROR "Exactly one fresh CLI receipt required")
endif()
list(GET after 0 report)
file(READ "${report}" json)
string(JSON status GET "${json}" status)
string(JSON cases GET "${json}" cases)
string(JSON checks GET "${json}" checks)
string(JSON original GET "${json}" original_executed)
string(JSON assets GET "${json}" original_assets)
string(JSON unchanged GET "${json}" all_input_hashes_unchanged)
if(NOT status STREQUAL "PASS" OR NOT cases EQUAL 29 OR NOT checks EQUAL 62 OR original OR assets OR NOT unchanged)
 message(FATAL_ERROR "CLI test status/count/scope mismatch")
endif()
message(STATUS "${stdout}; ${report}")
