if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT OR NOT DEFINED BASELINE_CATALOG)
  message(FATAL_ERROR "TEST_EXE, OUTPUT_ROOT and BASELINE_CATALOG are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(run "${OUTPUT_ROOT}/${stamp}-${nonce}")
if(EXISTS "${run}")
  message(FATAL_ERROR "Fresh Runtime cache trace output required")
endif()
file(TO_NATIVE_PATH "${run}" native_run)
file(TO_NATIVE_PATH "${BASELINE_CATALOG}" native_catalog)
execute_process(COMMAND "${TEST_EXE}" "${native_run}" "${native_catalog}"
  RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 120)
file(WRITE "${run}.process.log" "exit=${code}\n${stdout}\n${stderr}\n")
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Runtime cache trace failed: ${run}.process.log")
endif()
file(READ "${run}/report.json" report)
string(JSON status GET "${report}" status)
string(JSON count GET "${report}" count)
string(JSON catalog GET "${report}" catalog_operations)
string(JSON preserved GET "${report}" existing_descriptors_unchanged)
if(NOT status STREQUAL "PASS" OR NOT count EQUAL 14 OR NOT catalog EQUAL 227 OR NOT preserved EQUAL 222)
  message(FATAL_ERROR "Runtime cache trace acceptance incomplete")
endif()
message(STATUS "Runtime cache trace14 groups PASS;227operations,222historical descriptors preserved")
