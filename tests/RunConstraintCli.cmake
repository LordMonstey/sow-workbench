if(NOT DEFINED CLI OR NOT DEFINED EXE OR NOT DEFINED OUTPUT_ROOT)
 message(FATAL_ERROR "CLI EXE OUTPUT_ROOT required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
execute_process(COMMAND "${EXE}" "${CLI}" "${OUTPUT_ROOT}/case-${nonce}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
 message(FATAL_ERROR "Constraint CLI regression ${status}: ${error} ${output}")
endif()
string(JSON result GET "${output}" status)
if(NOT result STREQUAL "PASS")
 message(FATAL_ERROR "Unexpected CLI result ${output}")
endif()
message(STATUS "${output}")
