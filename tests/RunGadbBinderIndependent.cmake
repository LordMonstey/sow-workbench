if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "TEST_EXE and OUTPUT_ROOT are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(report "${OUTPUT_ROOT}/${stamp}-${nonce}.json")
if(EXISTS "${report}")
  message(FATAL_ERROR "Report already exists")
endif()
execute_process(COMMAND "${TEST_EXE}" RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE error TIMEOUT 90)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Independent binder failed: ${text} ${error}")
endif()
string(JSON status GET "${text}" status)
string(JSON groups GET "${text}" groups)
string(JSON cases GET "${text}" cases)
string(JSON checks GET "${text}" checks)
string(JSON bytes GET "${text}" whole_image_bytes_compared)
if(NOT status STREQUAL "PASS" OR NOT groups EQUAL 4 OR NOT cases EQUAL 36664 OR NOT checks EQUAL 110010 OR NOT bytes EQUAL 1222377472)
  message(FATAL_ERROR "Independent binder coverage differs: ${text}")
endif()
file(WRITE "${report}" "${text}")
message(STATUS "${text}")